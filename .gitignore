# 旧架构（aggregate 叠加）的 stage 输出目录——stage.sh 已随转向退役，
#   保留忽略项防误提交；新架构无此目录（apply-patches.sh 直接写用户指定的源码树）
.stage/

# 上游裁决基线（check-upstream.sh --baseline 写入；不能放 .stage/ 下）
.upstream-baseline

# gen-order.py 生成的备份
patches/ORDER.bak
*.bak

# 构建日志与产物
build-*.log
*.itb
*.bin

# OpenWrt 构建树残留（若误在仓库根构建）
build_dir/
staging_dir/
tmp/
bin/
dl/

# 编辑器 / 系统 / 缓存
.DS_Store
*.swp
*~
__pycache__/
*.pyc
.idea