#   验证：顺序链内（25 已移植件为底 + ORDER 序）对 openwrt main@63f702f1c git apply 干净
# Reason: airoha RX 恢复 IRQ/thermal
# 档位：func（v1-safe 不含）
diff --git a/target/linux/airoha/patches-6.18/980-net-airoha-handle-RX_NO_CPU_DSCP-interrupt-not-just-RX_DONE.patch b/target/linux/airoha/patches-6.18/980-net-airoha-handle-RX_NO_CPU_DSCP-interrupt-not-just-RX_DONE.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/980-net-airoha-handle-RX_NO_CPU_DSCP-interrupt-not-just-RX_DONE.patch
@@ -0,0 +1,82 @@
+From: netdev "[PATCH net v2 1/3] net: airoha: handle RX_NO_CPU_DSCP interrupt, not just RX_DONE"
+Date: Tue, 1 Sep 2026 00:00:00 +0000
+Subject: [PATCH] net: airoha: handle RX_NO_CPU_DSCP interrupt, not just RX_DONE
+
+Staged 2026-09-01 from a netdev "[PATCH net v2 N/3]" airoha RX series (raw diff
+only; author not recorded). NOT merged in torvalds/linux, stable, or OpenWrt
+master as of 2026-09-01 - re-check on each master sync and drop once it lands.
+Regenerated against this tree's effective airoha_eth source (0 fuzz/offset) and
+cross-compiled clean (no warnings) against a built 6.18.44 on 2026-09-01.
+
+The per-ring RX_NO_CPU_DSCP ("no free CPU descriptor") interrupts are
+enabled at init (INT_RX1/2_MASK include them) but airoha_irq_handler()
+masked the status down to RX_DONE only, so they were acked and ignored.
+A ring that fills up without a coincident RX_DONE never wakes its NAPI
+and stays dead until something else kicks it. Route the NO_CPU_DSCP bits
+to napi_schedule() for the owning queue and re-enable both bits in
+napi_poll. Bit layout verified: IDX1 = RX_DONE 0-15 + NO_CPU_DSCP 16-31
+(qid 0-15); IDX2 the same for qid 16-31 - consistent with 976's queue-31
+IRQ bank pin.
+
+W1700K relevance: candidate root cause for the "silent RX death after
+hours" / LAN2-RX-intermittently-dead class.
+
+---
+diff -ruN s0/drivers/net/ethernet/airoha/airoha_eth.c s1/drivers/net/ethernet/airoha/airoha_eth.c
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -1017,13 +1017,16 @@
+ 		int i, qid = q - &qdma->q_rx[0];
+ 		int intr_reg = qid < RX_DONE_HIGH_OFFSET ? QDMA_INT_REG_IDX1
+ 							 : QDMA_INT_REG_IDX2;
++		u32 irq_id = qid % RX_DONE_HIGH_OFFSET;
++		u32 intr_mask = BIT(irq_id) |
++				BIT(irq_id + RX_NO_CPU_DSCP_LOW_OFFSET);
+ 
+ 		for (i = 0; i < ARRAY_SIZE(qdma->irq_banks); i++) {
+ 			if (!(BIT(qid) & RX_IRQ_BANK_PIN_MASK(i)))
+ 				continue;
+ 
+ 			airoha_qdma_irq_enable(&qdma->irq_banks[i], intr_reg,
+-					       BIT(qid % RX_DONE_HIGH_OFFSET));
++					       intr_mask);
+ 		}
+ 	}
+ 
+@@ -1674,16 +1677,19 @@
+ 	if (!test_bit(DEV_STATE_INITIALIZED, &qdma->eth->state))
+ 		return IRQ_NONE;
+ 
+-	rx_intr1 = intr[1] & RX_DONE_LOW_INT_MASK;
++	rx_intr1 = intr[1] & (RX_DONE_LOW_INT_MASK | RX_NO_CPU_DSCP_LOW_INT_MASK);
+ 	if (rx_intr1) {
+ 		airoha_qdma_irq_disable(irq_bank, QDMA_INT_REG_IDX1, rx_intr1);
+-		rx_intr_mask |= rx_intr1;
++		rx_intr_mask |= (rx_intr1 & RX_DONE_LOW_INT_MASK) |
++				RX_NO_CPU_DSCP_INT_RX1_MASK(rx_intr1);
+ 	}
+ 
+-	rx_intr2 = intr[2] & RX_DONE_HIGH_INT_MASK;
++	rx_intr2 = intr[2] & (RX_DONE_HIGH_INT_MASK | RX_NO_CPU_DSCP_HIGH_INT_MASK);
+ 	if (rx_intr2) {
+ 		airoha_qdma_irq_disable(irq_bank, QDMA_INT_REG_IDX2, rx_intr2);
+-		rx_intr_mask |= (rx_intr2 << 16);
++		rx_intr_mask |= ((rx_intr2 & RX_DONE_HIGH_INT_MASK) <<
++				 RX_DONE_HIGH_OFFSET) |
++				(rx_intr2 & RX_NO_CPU_DSCP_HIGH_INT_MASK);
+ 	}
+ 
+ 	for (i = 0; rx_intr_mask && i < ARRAY_SIZE(qdma->q_rx); i++) {
+diff -ruN s0/drivers/net/ethernet/airoha/airoha_regs.h s1/drivers/net/ethernet/airoha/airoha_regs.h
+--- a/drivers/net/ethernet/airoha/airoha_regs.h
++++ b/drivers/net/ethernet/airoha/airoha_regs.h
+@@ -575,6 +575,8 @@
+ #define INT_RX1_MASK(_n)							\
+ 	((((_n) << RX_NO_CPU_DSCP_LOW_OFFSET) & RX_NO_CPU_DSCP_LOW_INT_MASK) |	\
+ 	 (RX_DONE_LOW_INT_MASK & (_n)))
++#define RX_NO_CPU_DSCP_INT_RX1_MASK(_n)					\
++	(((_n) & RX_NO_CPU_DSCP_LOW_INT_MASK) >> RX_NO_CPU_DSCP_LOW_OFFSET)
+ 
+ /* QDMA_CSR_INT_ENABLE3 */
+ #define RX31_NO_CPU_DSCP_INT_MASK	BIT(31)
+
diff --git a/target/linux/airoha/patches-6.18/976-net-airoha-enable-RX_DONE-interrupt-for-RX-queue-31.patch b/target/linux/airoha/patches-6.18/976-net-airoha-enable-RX_DONE-interrupt-for-RX-queue-31.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/976-net-airoha-enable-RX_DONE-interrupt-for-RX-queue-31.patch
@@ -0,0 +1,27 @@
+From: Lorenzo Bianconi <lorenzo@kernel.org>
+Date: Sun, 31 Aug 2026 00:00:00 +0000
+Subject: [PATCH] net: airoha: enable RX_DONE interrupt for RX queue 31
+
+RX_IRQ1_BANK_PIN_MASK maps rx queues 21-30 to IRQ bank 1 but misses
+BIT(31), so rx queue 31 never has its RX_DONE interrupt routed to an
+IRQ bank. With the HW GRO offload moving the LRO-capable rx queues to
+the high range (24-31), traffic hashed to queue 31 would fill the ring
+and stall with no completion interrupt. Add BIT(31) to the bank 1 pin
+mask.
+
+Companion fix to the net-next v5 "add HW GRO offload support" series;
+in this tree it complements 916-02 + 975 which already implement the
+same LRO queue layout.
+---
+--- a/drivers/net/ethernet/airoha/airoha_eth.h
++++ b/drivers/net/ethernet/airoha/airoha_eth.h
+@@ -538,7 +538,7 @@ struct airoha_wdma_info {
+ 
+ /* RX queue to IRQ mapping: BIT(q) in IRQ(n) */
+ #define RX_IRQ0_BANK_PIN_MASK			0x839f
+-#define RX_IRQ1_BANK_PIN_MASK			0x7fe00000
++#define RX_IRQ1_BANK_PIN_MASK			0xffe00000
+ #define RX_IRQ2_BANK_PIN_MASK			0x20
+ #define RX_IRQ3_BANK_PIN_MASK			0x40
+ #define RX_IRQ_BANK_PIN_MASK(_n)		\
+
diff --git a/target/linux/airoha/patches-6.18/957-net-airoha-fix-BQL-underflow-and-UAF-in-shared-QDMA-TX-ring.patch b/target/linux/airoha/patches-6.18/957-net-airoha-fix-BQL-underflow-and-UAF-in-shared-QDMA-TX-ring.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/957-net-airoha-fix-BQL-underflow-and-UAF-in-shared-QDMA-TX-ring.patch
@@ -0,0 +1,53 @@
+From: Gilly <gilroyscott1970@gmail.com>
+Date: Sat, 20 Jun 2026 00:00:00 +0000
+Subject: [PATCH] net: airoha: fix BQL underflow and UAF in shared QDMA TX ring
+
+Minimal form of Lorenzo Bianconi's BQL-underflow/UAF fix, re-scoped
+2026-06-20 for master @ 2026-06-19. Upstream meanwhile refactored DMA
+enable/disable into airoha_qdma_start()/airoha_qdma_stop() and already
+added the TX/RX DMA drain busy-poll in airoha_qdma_stop() (the part that
+local patch 628 used to add, and that the earlier v2 restructure folded
+into airoha_qdma_cleanup()). So the full v2 lifecycle restructure
+(DMA-at-probe / DEV_STATE_FLUSH / tx_flush) is no longer the right fit and
+would fight upstream's refactor.
+
+Two real bugs remain in the new base, fixed here directly:
+
+1) UAF: airoha_qdma_tx_napi_poll() read e->skb but never cleared it, so the
+   per-stop teardown (airoha_qdma_stop -> airoha_qdma_cleanup_tx_queue)
+   could act on a stale skb pointer. Clear e->skb when consumed.
+
+2) BQL underflow: airoha_qdma_cleanup_tx_queue() freed in-flight skbs
+   without netdev_tx_completed_queue(), underflowing BQL and wedging TX
+   after a stop that had packets in flight on the shared ring. Balance BQL
+   before freeing.
+
+This supersedes local patch 628 (drain-poll now upstream in
+airoha_qdma_stop) — 628 stays retired.
+---
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -1239,6 +1239,7 @@
+ 
+ 		e = &q->entry[index];
+ 		skb = e->skb;
++		e->skb = NULL;
+ 
+ 		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
+ 				 DMA_TO_DEVICE);
+@@ -1399,7 +1400,13 @@
+ 
+ 		dma_unmap_single(eth->dev, e->dma_addr, e->dma_len,
+ 				 DMA_TO_DEVICE);
+-		dev_kfree_skb_any(e->skb);
++		if (e->skb) {
++			struct netdev_queue *txq;
++
++			txq = skb_get_tx_queue(e->skb->dev, e->skb);
++			netdev_tx_completed_queue(txq, 1, e->skb->len);
++			dev_kfree_skb_any(e->skb);
++		}
+ 		e->dma_addr = 0;
+ 		e->skb = NULL;
+ 		list_add_tail(&e->list, &q->tx_list);
+
diff --git a/target/linux/airoha/patches-6.18/960-thermal-airoha-Fix-FIELD_PREP-using-wrong-mask-for-sensor-interval.patch b/target/linux/airoha/patches-6.18/960-thermal-airoha-Fix-FIELD_PREP-using-wrong-mask-for-sensor-interval.patch
