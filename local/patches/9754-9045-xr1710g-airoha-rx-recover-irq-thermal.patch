diff --git a/target/linux/airoha/patches-6.18/980-net-airoha-handle-RX_NO_CPU_DSCP-interrupt-not-just-RX_DONE.patch b/target/linux/airoha/patches-6.18/980-net-airoha-handle-RX_NO_CPU_DSCP-interrupt-not-just-RX_DONE.patch
