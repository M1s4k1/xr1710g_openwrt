+-	err = airoha_npu_wlan_set_reserved_memory(npu, 0, "tx-pkt", cmd);
++	err = airoha_npu_wlan_cmd_with_retry(npu, 0, cmd, "tx-pkt", 0, NULL);
+ 	if (err)
+ 		return err;
+ 
