# Source: 本仓库自研（local/patches/）
# Upstream: n/a
# Reason: 预装常用运维工具、UPnP、Argon 主题与完整中文语言支持（含 13 个完整汉化 lmo 与 uci-defaults 默认中文初始化）
diff --git a/files/etc/uci-defaults/98-xr1710g-luci-default-lang b/files/etc/uci-defaults/98-xr1710g-luci-default-lang
new file mode 100755
index 0000000..9e03d04
--- /dev/null
+++ b/files/etc/uci-defaults/98-xr1710g-luci-default-lang
@@ -0,0 +1,12 @@
+#!/bin/sh
+# 98-xr1710g-luci-default-lang — 默认语言与主题初始化
+# 首次开机自动将 LuCI 界面语言设为中文（zh_cn）并保持 Argon 主题
+
+if [ "$PKG_UPGRADE" != 1 ]; then
+	uci batch <<-EOF
+		set luci.main.lang='zh_cn'
+		commit luci
+	EOF
+fi
+
+exit 0
