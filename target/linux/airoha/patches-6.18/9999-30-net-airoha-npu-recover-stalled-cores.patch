# Source: YYH2913/openwrt@xr1710g-6.18-integration target/linux/airoha/patches-6.18/923-net-airoha-npu-recover-stalled-cores.patch
#   （Yanghan Ye, 2026-08-06, d6b07d31）—— 2026-09-12 P3-A 吸收，#EXP
# Upstream: n/a（作者自持，未见 PR）
# Reason: NPU watchdog 只抓 coredump 不重启停滞的 firmware core；mailbox 用户只能等满超时，
#   无线卸载不重启整机无法恢复。本补丁从 Airoha vendor SDK（private/npu/host/npu_rv32.c）
#   移植恢复序列：保留 enabled-core mask、对受影响 core 置 reboot 位、间隔 100ms 触发两次
#   清总线残留、重启 core 0 前把 MIB0 置全 1 以保留 BSS/PLIC/timer 状态。并暴露同步的
#   airoha_npu_recover()（core 0）供 NPU 消费者使用；recovery 期间 mailbox 请求返回 -EAGAIN。
# 重基：本仓真源已含上游 924-use-coherent（__airoha_npu_send_msg + per-core coherent buf），
#   故 send_msg 两个 hunk 由旧 dma_map_single 上下文重锚到 __airoha_npu_send_msg
#   （guard 紧跟 spin_lock_bh(&core->lock)，unlock: 标签在 spin_unlock_bh 之前）。
# 位置：ROOT 包裹补丁内层，序号 9999-30（排在 SOE 9999-1x/2x 之后 → 内核应用顺序最后）。
# 实证：对 linux 6.18.44 真源（kernel-base）按序应用 fuzz=0。
diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
index 51eebdf..5ad6389 100644
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -189,6 +189,10 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	 * foe_commit under atomic context).
 	 */
 	spin_lock_bh(&core->lock);
+	if (npu->recovering) {
+		ret = -EAGAIN;
+		goto unlock;
+	}
 
 	memcpy(core->buf, data, len);
 
@@ -210,6 +214,7 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	if (!ret && reply)
 		memcpy(reply, core->buf + len - reply_len, reply_len);
 
+unlock:
 	spin_unlock_bh(&core->lock);
 
 	return ret;
@@ -317,6 +322,54 @@ static irqreturn_t airoha_npu_mbox_handler(int irq, void *npu_instance)
 	return IRQ_HANDLED;
 }
 
+static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
+{
+	int i, err = 0;
+	u32 val;
+
+	if (core < 0 || core >= ARRAY_SIZE(npu->cores))
+		return -EINVAL;
+
+	mutex_lock(&npu->recovery_lock);
+
+	spin_lock_bh(&npu->cores[0].lock);
+	npu->recovering = true;
+	err = regmap_read(npu->regmap, REG_CR_BOOT_CONFIG, &val);
+	spin_unlock_bh(&npu->cores[0].lock);
+	if (err)
+		goto out;
+
+	val = (val & GENMASK(7, 0)) | BIT(8 + core);
+	for (i = 0; i < 2; i++) {
+		spin_lock_bh(&npu->cores[0].lock);
+		err = regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, val);
+		if (!err && !core)
+			err = regmap_write(npu->regmap, REG_CR_NPU_MIB(0),
+					   U32_MAX);
+		if (!err)
+			err = regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 2);
+		spin_unlock_bh(&npu->cores[0].lock);
+		if (err)
+			break;
+
+		msleep(100);
+	}
+
+out:
+	spin_lock_bh(&npu->cores[0].lock);
+	npu->recovering = false;
+	spin_unlock_bh(&npu->cores[0].lock);
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+
+int airoha_npu_recover(struct airoha_npu *npu)
+{
+	return airoha_npu_restart_core(npu, 0);
+}
+EXPORT_SYMBOL_GPL(airoha_npu_recover);
+
