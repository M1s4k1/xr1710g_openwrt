@@ -328,16 +381,20 @@ static void airoha_npu_wdt_work(struct work_struct *work)
 	core = container_of(work, struct airoha_npu_core, wdt_work);
 	npu = core->npu;
 
-	dump = vzalloc(NPU_DUMP_SIZE);
-	if (!dump)
-		return;
-
 	c = core - &npu->cores[0];
-	regmap_bulk_read(npu->regmap, REG_PC_DBG(c), val, ARRAY_SIZE(val));
-	snprintf(dump, NPU_DUMP_SIZE, "PC: %08x SP: %08x LR: %08x\n",
-		 val[0], val[1], val[2]);
+	dump = vzalloc(NPU_DUMP_SIZE);
+	if (dump) {
+		regmap_bulk_read(npu->regmap, REG_PC_DBG(c), val,
+				 ARRAY_SIZE(val));
+		snprintf(dump, NPU_DUMP_SIZE,
+			 "PC: %08x SP: %08x LR: %08x\n",
+			 val[0], val[1], val[2]);
+		dev_coredumpv(npu->dev, dump, NPU_DUMP_SIZE, GFP_KERNEL);
+	}
 
-	dev_coredumpv(npu->dev, dump, NPU_DUMP_SIZE, GFP_KERNEL);
+	dev_warn(npu->dev, "restarting NPU core %d after watchdog timeout\n", c);
+	if (airoha_npu_restart_core(npu, c))
+		dev_err(npu->dev, "failed to restart NPU core %d\n", c);
 }
 
 static irqreturn_t airoha_npu_wdt_handler(int irq, void *core_instance)
@@ -734,6 +791,7 @@ static int airoha_npu_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	npu->dev = dev;
+	mutex_init(&npu->recovery_lock);
 	npu->ops.ppe_init = airoha_npu_ppe_init;
 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
