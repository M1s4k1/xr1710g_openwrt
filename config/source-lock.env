# canonical OpenWrt base lock（2026-10-21 架构转向后）
#
# 本仓库以 OpenWrt 主线为基座；aggregate/ 已退役为参考目录（见 aggregate/REFERENCE.md）。
# builds never fetch：构建只用本地源码树（--tree 指定），此处仅记录 pin 供校验。

OPENWRT_SOURCE=https://github.com/openwrt/openwrt.git
OPENWRT_REF=63f702f1c0cebe2587aac10b63a02e964fc2a558
LINUX_VERSION=6.18.55

# 退役项（保留备查）：aggregate 快照来源，构建不再使用
# AGGREGATE_SOURCE_ORIGIN=https://github.com/genshanxinli/xr1710g-openwrt.git
# AGGREGATE_SOURCE_COMMIT=244d433374b5a49904d6ca107f078553b37c6111

