# local/seed.local.diff — 设备与预装包选择（架构转向后唯一 seed）
# 生成日期 2026-10-21（合并原 aggregate/config/seed-config.diff 的本项目符号 + 原本地差额）
#
# 应用方式：build-mine.sh 在 `make defconfig` 后把本文件追加进 .config，再 `make defconfig`
#   解析；audit-local.sh 逐符号比对取值（F15 教训：kconfig 静默忽略未知符号）。
#
# ⚠ 写法铁律（F164）：活动 CONFIG_* 行只允许「符号=取值」，说明写到上一行注释；
#   尾随注释会被 kconfig 截断 ⇒ 静默丢符号。
# ⚠ 不要写 CONFIG_PACKAGE_ethtool-full=y（与 ethtool provides 冲突）。

# ── 目标：gemtek_xr1710g-ubi（板级使能由本地补丁 9401/9402 提供）──
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# 设备符号 = CONFIG_TARGET_<board>_<subtarget>_DEVICE_<device>
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y

# ── 基础系统（官方包）──
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
# 全功能（mesh/SAE 预留在位，为 802.11s/EHT320 回程）
#   ⚠ F164-ALLOW-RESOLVED-M: 本项被 CONFLICTS 压到 =m（hostapd/Makefile 的 wpad 变体互相
#     CONFLICTS，wpad-basic-mbedtls 是同组 DEFAULT_VARIANT 故 =y）⇒ 镜像实际装
#     wpad-basic-mbedtls，丢 802.11s mesh / SUITEB192 / EAP_PWD / DPP；SAE 未丢。
#     修法（需单独一轮构建 + 实机回归，勿随手改）：本行改 wpad-mesh-openssl 或
#     wpad-mesh-mbedtls，并把 CONFIG_PACKAGE_wpad-basic-mbedtls 显式置 n。
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano=y

# ── 设备驱动/kmod（官方包）──
# NPU 固件（上游 #22289 已合，主线直接供给）
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
# 10G PHY 固件 blob（#23427 已合）
CONFIG_PACKAGE_rtl826x-firmware=y
# 10G PHY 驱动（6.18 切 kmod-phy-realtek）
CONFIG_PACKAGE_kmod-phy-realtek=y
# 风扇温控传感器（动态探测）
CONFIG_PACKAGE_kmod-hwmon-nct7802=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y

# ── LuCI 与工具（官方包）──
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_irqbalance=y
# 诊断工具：NPU RPC 依赖 devmem/ethtool/bridge；tcpdump/iperf3 供深度排障
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
# devmem 根因修复：busybox devmem 只是用户态工具，内核必须提供 /dev/mem；
#   OpenWrt 通用内核默认 CONFIG_DEVMEM is not set，mknod 后 open 仍 ENXIO。
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y

# ── 运维基础套件（原本地差额）──
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
# phytool：PHY 寄存器读写（10G/1G PHY 排障）
CONFIG_PACKAGE_phytool=y
# mdio-tools：MDIO 总线访问（PHY 层诊断）
CONFIG_PACKAGE_mdio-tools=y
# ip-full：完整版 iproute2
CONFIG_PACKAGE_ip-full=y
# openssh-sftp-server：SFTP 服务端（备份/传文件）
CONFIG_PACKAGE_openssh-sftp-server=y
# UPnP 端口自动映射
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# ── Argon 主题与配置界面（9603 补丁经 packages-xr1710g feed 供给）──
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# 语言包支持（开启全局中文 + 显式声明各应用 zh-cn 包）
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-irqbalance-zh-cn=y

# ── Phase 2 恢复项（2026-10-23 执行恢复：NPU 栈移植已完成）──
# bridge-hw-offload：本仓库自有包（package/network/config/bridge-hw-offload，
#   commit "platform fix bundle" 创建）——桥接硬件卸载规则，配合 NPU/PPE 栈
CONFIG_PACKAGE_bridge-hw-offload=y
# luci-app-mlo / luci-app-w1700k-fancontrol / luci-app-airoha-npu /
# luci-app-airoha-flowsense：随 NPU 栈一并移植进 package/（commit "NPU/PPE
# hardware offload stack"），zh-cn 翻译由 files/ 下 13 个 lmo 供给（9603）
CONFIG_PACKAGE_luci-app-mlo=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
# luci-app-filemanager：aggregate seed 原有，迁移时漏选，现补回（luci feed 官方包）
CONFIG_PACKAGE_luci-app-filemanager=y
# luci-app-airoha-recovery：**暂不可恢复**——源码在 aggregate 的 fanboy 19-pack，
#   移植时未跟来（openwrt 官方 feed 无此包）。需要时从 aggregate 提取源码后
#   加入 packages-xr1710g feed 再启用。
# CONFIG_PACKAGE_luci-app-airoha-recovery=y
# per-STA debugfs（排障时取消注释并重编）
# CONFIG_PACKAGE_MAC80211_DEBUGFS=y

# ── 暂缓（决策）：科学上网 / Docker ──
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_docker=y
