#   不选 kmod-bonding 则 33..38 号补丁是死代码（不编译、也不可能生效）。
#   ip-full：建 bond 需要 `ip link add type bond`，busybox ip 与 ip-tiny 都不支持 link type
#   （本仓共享 seed 未选 ip-tiny/iproute2，故不产生 provides=ip 冲突）。
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_ip-full=y

