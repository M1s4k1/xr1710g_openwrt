# seed-config.diff — 设备与预装包选择（追加到 .config 后 make defconfig）
# 决策：主路由形态 + 双 release（stock/oc）共用同一 seed；oc 档差异只在 prepare-oc.sh。
# 注意：依赖自定义 feed 的包需 feed 已供给（config/feeds.custom.conf）；未供给的先注释，构建通过后逐个解锁。
# 每项带来源：O=官方包 / C=自定义feed / T=TODO待供给
#
# ── 写法铁律（F164，2026-09-14）──
# 1) 活动 `CONFIG_*` 行**只允许**「符号=取值」，说明一律写到**上一行**的注释里。
#    尾随注释（`CONFIG_X=y   # 说明`）是脆弱写法：kconfig 目前在空白/`#` 处截断取值，
#    行为随版本/上游变化，一旦不截断就是**静默丢符号**（F15 同族）。seed-config.diff /
#    seed-config.experimental.diff 两份都必须遵守——`scripts/audit-config.sh` 会在构建配置阶段
#    对尾随注释逐条打 ⚠（2026-09-14 已把本文件与实验档的 9 处全部规范化，当前 0 处）。
# 2) 期望取值被 kconfig 压低的已知情形，必须在符号的**紧邻上一行**注释里写
#    `F164-ALLOW-RESOLVED-M: <理由>`，否则 scripts/audit-config.sh 判红（不静默降级）。
# 3) scripts/audit-config.sh 现在逐符号比对**取值**（不止存在性）：want=y 而解析成 m
#    = 构建出来但不装进镜像 = 能力静默丢失 ⇒ 红。

# ── 目标：gemtek_xr1710g-ubi（#22397 板级补丁提供）──
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
# 设备符号 = CONFIG_TARGET_<board>_<subtarget>_DEVICE_<device>（metadata.pm confstr 清洗 target 名，profile id 保留 DEVICE_ 前缀与连字符）
CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y
# 备选：同源 W1700K（官方已合入）CONFIG_TARGET_airoha_an7581_DEVICE_gemtek_w1700k-ubi=y

# ── 基础系统（O）──
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
# 全功能（mesh/SAE 预留在位，为 802.11s/EHT320 回程）
#   ⚠ F164-ALLOW-RESOLVED-M: 本项被 CONFLICTS 压到 =m（hostapd/Makefile 的 wpad 变体互相 CONFLICTS，
#     而 wpad-basic-mbedtls 是同组 DEFAULT_VARIANT 故 =y）⇒ 镜像实际装的是 wpad-basic-mbedtls，
#     **丢 802.11s mesh（CONFIG_MESH）/SUITEB192/EAP_PWD/DPP**；SAE 未丢。
#     修法（需单独一轮构建 + 实机 V5.x 回归，勿随手改）：本行改 wpad-mesh-openssl 或 wpad-mesh-mbedtls，
#     并把 CONFIG_PACKAGE_wpad-basic-mbedtls 显式置 n（否则 CONFLICTS 仍把它压成 m）；台账见 FIXES F164。
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
# per-STA debugfs（mt76 hw-queues/fixed_rate 等；需 root/9049 的 NOSTDINC_FLAGS 映射才生效）：
# F105 批次 2026-09-12 加入——诊断 NPU per-station 计数（F79/F94/F95 与 issue #5/#7）时的关键手段。
# 默认关闭（保持镜像最小）；排障时取消注释并重编。
# CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano=y

# ── 设备驱动/kmod（O；决策默认档）──
# NPU 固件（上游 #22289 已合）
CONFIG_PACKAGE_airoha-en7581-mt7996-npu-firmware=y
# 10G PHY 固件 blob（#23427 已合）
CONFIG_PACKAGE_rtl826x-firmware=y
# 10G PHY 驱动（6.18 切 kmod-phy-realtek，ecabaa534e）
CONFIG_PACKAGE_kmod-phy-realtek=y
# 风扇温控传感器（动态探测，见 files/etc/init.d/fan）
CONFIG_PACKAGE_kmod-hwmon-nct7802=y
# an7581 的 I2C 控制器 = mediatek,mt7621-i2c（CONFIG_I2C_MT7621=y 内核内置）——无需/不存在 kmod-i2c-an7581（F17 移除）
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-mt7996-firmware=y
CONFIG_PACKAGE_kmod-mt7996e=y

# ── LuCI 与工具（O / C）──
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_irqbalance=y
# 诊断工具（issue #2/F42）：NPU RPC 依赖 devmem/ethtool/bridge；tcpdump/iperf3 供深度排障
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
# devmem 根因修复（issue #2）：busybox devmem applet 只是用户态工具，内核必须提供 /dev/mem 驱动；
# OpenWrt 通用内核配置默认 `CONFIG_DEVMEM is not set`，设备上 mknod /dev/mem 后 open 仍 ENXIO。
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
# 应用包（C：packages-xr1710g src-link / patches/vendor/fanboy/19 随树内置；拆包评审后可选 src-git feed，见 FIXES F13）：
CONFIG_PACKAGE_luci-app-mlo=y
CONFIG_PACKAGE_luci-app-w1700k-fancontrol=y
# NPU 诊断（决策已选，19-pack 内置）
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 流量卸载诊断（19-pack 内置）
CONFIG_PACKAGE_luci-app-airoha-flowsense=y
# 官方 luci feed（O）
CONFIG_PACKAGE_luci-app-filemanager=y
# 恢复页入口（C：packages-xr1710g src-link，锁 dd9ecfeef）
CONFIG_PACKAGE_luci-app-airoha-recovery=y

# bridge-hw-offload 由 vendor/05 + root/9024 提供（issue #1 E1/E3；ci-74 实验档验证通过，毕业 default 后 stock 档也应安装）。
# 2026-09-12 P4：包随上游改名 bridge-flow-offload→bridge-hw-offload（原 9043 守门已内置入 05，遂删除）。
CONFIG_PACKAGE_bridge-hw-offload=y

# ── 暂缓（决策）：科学上网 / Docker ──
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_docker=y
