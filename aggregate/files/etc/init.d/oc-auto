#!/bin/sh /etc/rc.common
# oc-auto — 唯一 CPU OC 档的运行时策略：最高 1350MHz，自动退档 1300/1200。
#
# 背景（2026-09-08 决策，取代 oc-1.3/oc-1.4 分档 + oc-limit 静态限频，见 FIXES F89）：
#   构建侧 OPP 表为 650–1350MHz（scripts/prepare-oc.sh oc，PLL base 650）。
#   1350 是社区已知“可能两分钟后重置”的档位、且个体体质差异（部分机器启动 panic），
#   因此本脚本做启动级稳性确认：
#     - 开机按 /etc/oc-state/level 设置上限（默认 1350；performance governor；可 sysfs 调低）；
#     - 撑过 CONFIRM_WINDOW 秒（默认 300，覆盖“两分钟重置”不稳窗口）才写 confirmed 标记；
#     - 若窗口内崩溃/重启（confirmed 缺失）→ 下次启动自动退档：1350→1300→1200；
#     - 首启（无 level 文件 = 全新安装）默认 1350，不误判退档；
#     - 窗口外崩溃不自动退档（如需降：sysfs 调低或写 level 文件后重启）；
#     - 1200 为最终兜底（原 stock 上限），不再退；
#     - 手动回高挡：echo 1350 > /etc/oc-state/level && reboot
#     - 手动即时调低：echo 1300000 > /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
#       （重启回退到 level 文件值）
START=97

LEVEL_FILE=/etc/oc-state/level
CONFIRM_FILE=/etc/oc-state/confirmed
CONFIRM_WINDOW="${CONFIRM_WINDOW:-300}"

degrade() {
	case "$1" in
		1350) echo 1300 ;;
		*) echo 1200 ;;
	esac
}

boot() {
	mkdir -p /etc/oc-state

	had_level=0
	[ -f "$LEVEL_FILE" ] && had_level=1
	cur="$(cat "$LEVEL_FILE" 2>/dev/null)"
	[ -n "$cur" ] || cur=1350
	case "$cur" in 1350|1300|1200) ;; *) cur=1350 ;; esac

	if [ "$had_level" -eq 1 ] && [ ! -f "$CONFIRM_FILE" ]; then
		next="$(degrade "$cur")"
		if [ "$next" != "$cur" ]; then
			logger -t oc-auto "上次 ${cur}MHz 未通过稳性确认（窗口内崩溃/重启），自动退档 → ${next}MHz"
			cur="$next"
		fi
	fi
	echo "$cur" > "$LEVEL_FILE"
	rm -f "$CONFIRM_FILE"

	for p in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$p" ] || continue
		[ -f "$p/scaling_max_freq" ] || continue
		[ -f "$p/scaling_governor" ] && echo performance > "$p/scaling_governor" 2>/dev/null
		hwmax="$(cat "$p/cpuinfo_max_freq" 2>/dev/null)" || continue
		want=$((cur * 1000))
		[ "$want" -gt "$hwmax" ] && want="$hwmax"
		if echo "$want" > "$p/scaling_max_freq" 2>/dev/null; then
			logger -t oc-auto "OC 上限 ${cur}MHz（hwmax=${hwmax}；可 sysfs 调低，重启回退）"
		fi
	done

	# 稳性确认：窗口内崩溃则 confirmed 缺失 → 下次启动退档。
	( sleep "$CONFIRM_WINDOW"; [ "$(cat "$LEVEL_FILE" 2>/dev/null)" = "$cur" ] && touch "$CONFIRM_FILE" ) &
}