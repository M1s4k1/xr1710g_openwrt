# files/etc/config/system — 默认系统设置
config system
	option hostname 'xr1710g'
	option ttylogin '0'
	option log_size '64'
	option urandom_seed '0'
	option zonename 'Asia/Shanghai'
	option timezone 'CST-8'
	option compat_version '2.0'

config timeserver 'ntp'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'
	list server '2.openwrt.pool.ntp.org'
	list server '3.openwrt.pool.ntp.org'
	option enabled '1'
	option enable_server '0'

config led 'led_wan_green'
	option name 'WAN Green'
	option sysfs 'mt7530_dsa-0:09:green:lan'
	option trigger 'netdev'
	option dev 'wan'
	option mode 'link'

config led 'led_wan_amber'
	option name 'WAN Amber'
	option sysfs 'mt7530_dsa-0:09:amber:lan'
	option trigger 'netdev'
	option dev 'wan'
	option mode 'tx rx'

config led 'led_lan3_green'
	option name 'LAN3 Green'
	option sysfs 'mt7530_dsa-0:0a:green:lan'
	option trigger 'netdev'
	option dev 'lan3'
	option mode 'link'

config led 'led_lan3_amber'
	option name 'LAN3 Amber'
	option sysfs 'mt7530_dsa-0:0a:amber:lan'
	option trigger 'netdev'
	option dev 'lan3'
	option mode 'tx rx'

config led 'led_lan1_green'
	option name 'LAN1 10G Green'
	option sysfs 'mt7530_dsa-0:08:green:lan'
	option trigger 'netdev'
	option dev 'lan1'
	option mode 'link tx rx'

config led 'led_lan2_green'
	option name 'LAN2 10G Green'
	option sysfs 'mt7530_dsa-0:05:green:lan'
	option trigger 'netdev'
	option dev 'lan2'
	option mode 'link tx rx'
