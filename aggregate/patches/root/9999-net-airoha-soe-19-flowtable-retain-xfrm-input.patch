diff --git a/target/linux/airoha/patches-6.18/9999-net-airoha-soe-19-flowtable-retain-xfrm-input.patch b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-19-flowtable-retain-xfrm-input.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-19-flowtable-retain-xfrm-input.patch
@@ -0,0 +1,96 @@
+# Source: hurryman2212/OpenW1700k-test @offload-oc 9999-19（2026-09-12 P2 SOE 主体吸收，按本仓真源重基）
+# 完整说明（依赖链/重基依据/判据）见 patches/MANIFEST 与 research-20260912/inner/soe-head.txt
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] netfilter: flowtable: retain XFRM input state in flows
+
+Retain and release authenticated XFRM input state with flowtable entries.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ net/netfilter/nf_flow_table_core.c | 32 ++++++++++++++++++++++++++++++
+ 1 file changed, 32 insertions(+)
+
+# Reason（适配本仓真源 = OpenWrt 真实 prepare 树，kernel-base commit 058cfa7；
+#        对照树 tmp/soe-adapt4/real；不是 soe-basetree.sh --fuzz=2 重放的近似树 kvanilla）：
+#   - 原 hunk #1（include 区，唯一失配）：真源 net/netfilter/nf_flow_table_core.c 开头没有
+#     hurryman 基线的 `#if IS_ENABLED(CONFIG_NET_SWITCHDEV) / #include <net/switchdev.h> / #endif`
+#     三行（真源 include 列表到 nf_conntrack_tuple.h 即结束），上下文失配；
+#     按真源重写上下文，`+#include <net/xfrm.h>` 仍插在最后一个 include 之后，语义不变。
+#   - 原 hunk #2..#5：真源仅行号偏移，上下文原样匹配，未改动。
+#   - 无整体重复：真源 nf_flow_table_core.c 无任何 xfrm_input 相关代码；
+#     A 系列（9053 内层 9999-xfrm-00-packet-offload-framework.patch）只改 include/{linux/netdevice.h,
+#     net/netns/xfrm.h,net/xfrm.h} 与 net/xfrm/*.c，不触碰任何 net/netfilter/ 文件，与本补丁无重叠。
+diff --git a/net/netfilter/nf_flow_table_core.c b/net/netfilter/nf_flow_table_core.c
+index 2bb0339..624867b 100644
+--- a/net/netfilter/nf_flow_table_core.c
++++ b/net/netfilter/nf_flow_table_core.c
+@@ -12,6 +12,7 @@
+ #include <net/netfilter/nf_conntrack_core.h>
+ #include <net/netfilter/nf_conntrack_l4proto.h>
+ #include <net/netfilter/nf_conntrack_tuple.h>
++#include <net/xfrm.h>
+ 
+ static DEFINE_MUTEX(flowtable_lock);
+ static LIST_HEAD(flowtables);
+@@ -115,6 +116,17 @@ static struct dst_entry *nft_route_dst_fetch(struct nf_flow_route *route,
+ 	return dst;
+ }
+ 
++static struct xfrm_state *
++nft_route_xfrm_fetch(struct nf_flow_route *route,
++		     enum flow_offload_tuple_dir dir)
++{
++	struct xfrm_state *x = route->tuple[dir].xfrm_input;
++
++	route->tuple[dir].xfrm_input = NULL;
++
++	return x;
++}
++
+ static int flow_offload_fill_route(struct flow_offload *flow,
+ 				   struct nf_flow_route *route,
+ 				   enum flow_offload_tuple_dir dir)
+@@ -141,6 +153,12 @@ static int flow_offload_fill_route(struct flow_offload *flow,
+ 		j++;
+ 	}
+ 	flow_tuple->encap_num = route->tuple[dir].in.num_encaps;
++	flow_tuple->xfrm_input = nft_route_xfrm_fetch(route, dir);
++	flow_tuple->xfrm_input_flow_id =
++		route->tuple[dir].xfrm_input_flow_id;
++	flow_tuple->xfrm_policy_genid = route->tuple[dir].xfrm_policy_genid;
++	flow_tuple->xfrm_input_deferred =
++		route->tuple[dir].xfrm_input_deferred;
+ 
+ 	switch (route->tuple[dir].xmit_type) {
+ 	case FLOW_OFFLOAD_XMIT_DIRECT:
+@@ -174,6 +192,18 @@ static void nft_flow_dst_release(struct flow_offload *flow,
+ 		dst_release(flow->tuplehash[dir].tuple.dst_cache);
+ }
+ 
++static void
++nft_flow_xfrm_release(struct flow_offload *flow,
++		      enum flow_offload_tuple_dir dir)
++{
++#if IS_ENABLED(CONFIG_XFRM)
++	struct xfrm_state *x = flow->tuplehash[dir].tuple.xfrm_input;
++
++	if (x)
++		xfrm_state_put(x);
++#endif
++}
++
+ void flow_offload_route_init(struct flow_offload *flow,
+ 			     struct nf_flow_route *route)
+ {
+@@ -269,6 +299,8 @@ static void flow_offload_route_release(struct flow_offload *flow)
+ {
+ 	nft_flow_dst_release(flow, FLOW_OFFLOAD_DIR_ORIGINAL);
+ 	nft_flow_dst_release(flow, FLOW_OFFLOAD_DIR_REPLY);
++	nft_flow_xfrm_release(flow, FLOW_OFFLOAD_DIR_ORIGINAL);
++	nft_flow_xfrm_release(flow, FLOW_OFFLOAD_DIR_REPLY);
+ }
+ 
+ void flow_offload_free(struct flow_offload *flow)
