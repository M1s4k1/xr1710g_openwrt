diff --git a/target/linux/airoha/patches-6.18/9999-net-airoha-soe-20-flowtable-discover-xfrm-state.patch b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-20-flowtable-discover-xfrm-state.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-20-flowtable-discover-xfrm-state.patch
@@ -0,0 +1,167 @@
+# Source: hurryman2212/OpenW1700k-test @offload-oc 9999-20（2026-09-12 P2 SOE 主体吸收，按本仓真源重基）
+# 完整说明（依赖链/重基依据/判据）见 patches/MANIFEST 与 research-20260912/inner/soe-head.txt
+# Reason（重基目标 = **本仓真实 prepare 内容**：上游 6.18 内核补丁 + vendor/fanboy/06 内层 675-01..03
+#         + 本仓 airoha 内层全序；对照文件 research-20260912/inner/path-post675.c，365 行）：
+#   - 2026-09-13（F142）二次重基：初版按 kernel-base（**不含** 675）重写上下文，故在真实树上
+#     hunk #1/#3/#6 FAILED —— 675 改了 include 区、把 nft_flow_route() 重写为带 `is_bridging`
+#     的形态、且 nft_dev_forward_path() 是 7 参 int 返回。本版整份内层由 git diff 机器生成。
+#   - 原作者基线的 `nft_flow_route_routing()` 不存在于本仓（那是作者侧的上游重构）；原 hunk #4/#5
+#     的 fl4 proto/sport/dport 三行按真源落到 nft_flow_route() 的 IPv4/IPv6 分支。
+#   - XFRM 发现块置于 `skip_l3:` 之前 ⇒ 只对路由流生效；675 的桥接快路径（is_bridging）不受影响。
+#   - 675 的 `nft_dev_forward_path()` 形态（7 参/int/错误处理）原样保留为上下文；本补丁新增的
+#     err_dst_release 块只服务本补丁自己的 XFRM 判定分支（初版按 void 返回改写的那段已作废）。
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] netfilter: flowtable: discover XFRM state for flow
+ routes
+
+Discover authenticated inbound and eligible outbound XFRM state while resolving flow routes.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ net/netfilter/nf_flow_table_path.c | 85 ++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 85 insertions(+)
+diff --git a/net/netfilter/nf_flow_table_path.c b/net/netfilter/nf_flow_table_path.c
+index fc8abab..c72c25a 100644
+--- a/net/netfilter/nf_flow_table_path.c
++++ b/net/netfilter/nf_flow_table_path.c
+@@ -14,6 +14,7 @@
+ #include <net/netfilter/nf_conntrack_core.h>
+ #include <net/netfilter/nf_conntrack_extend.h>
+ #include <net/netfilter/nf_flow_table.h>
++#include <net/xfrm.h>
+ #include <linux/if_bridge.h>
+ #include <net/route.h>
+ #include <net/ip6_route.h>
+@@ -26,6 +27,24 @@ static enum flow_offload_xmit_type nft_xmit_type(struct dst_entry *dst)
+ 	return FLOW_OFFLOAD_XMIT_NEIGH;
+ }
+ 
++#if IS_ENABLED(CONFIG_XFRM)
++static bool nft_flow_route_needs_xfrm_input(const struct nf_flow_route *route,
++					    enum ip_conntrack_dir dir)
++{
++	const struct dst_entry *dst = route->tuple[dir].dst;
++	const struct xfrm_state *x;
++
++	if (route->tuple[dir].xmit_type != FLOW_OFFLOAD_XMIT_XFRM)
++		return false;
++
++	x = dst_xfrm(dst);
++	if (x && x->xso.flags & XFRM_DEV_OFFLOAD_FLAG_FLOWTABLE_INPUT)
++		return true;
++
++	return false;
++}
++#endif
++
+ static void nft_default_forward_path(struct nf_flow_route *route,
+ 				     struct dst_entry *dst_cache,
+ 				     enum ip_conntrack_dir dir)
+@@ -281,6 +300,10 @@ int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
+ 	bool is_bridging = false;
+ 	struct net_device *br_dev;
+ 	struct flowi fl = {};
++#if IS_ENABLED(CONFIG_XFRM)
++	struct xfrm_offload *xo;
++	struct sec_path *sp;
++#endif
+ 
+ 	if (netif_is_bridge_port(pkt->skb->dev)) {
+ 		rcu_read_lock();
+@@ -324,6 +347,10 @@ int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
+ 		fl.u.ip4.flowi4_dscp = ip4h_dscp(ip_hdr(pkt->skb));
+ 		fl.u.ip4.flowi4_mark = pkt->skb->mark;
+ 		fl.u.ip4.flowi4_flags = FLOWI_FLAG_ANYSRC;
++		fl.u.ip4.flowi4_proto =
++			ct->tuplehash[!dir].tuple.dst.protonum;
++		fl.u.ip4.fl4_sport = ct->tuplehash[!dir].tuple.src.u.all;
++		fl.u.ip4.fl4_dport = ct->tuplehash[dir].tuple.src.u.all;
+ 		break;
+ 	case NFPROTO_IPV6:
+ 		fl.u.ip6.daddr = ct->tuplehash[dir].tuple.src.u3.in6;
+@@ -333,6 +360,10 @@ int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
+ 		fl.u.ip6.flowlabel = ip6_flowinfo(ipv6_hdr(pkt->skb));
+ 		fl.u.ip6.flowi6_mark = pkt->skb->mark;
+ 		fl.u.ip6.flowi6_flags = FLOWI_FLAG_ANYSRC;
++		fl.u.ip6.flowi6_proto =
++			ct->tuplehash[!dir].tuple.dst.protonum;
++		fl.u.ip6.fl6_sport = ct->tuplehash[!dir].tuple.src.u.all;
++		fl.u.ip6.fl6_dport = ct->tuplehash[dir].tuple.src.u.all;
+ 		break;
+ 	}
+ 
+@@ -345,11 +376,54 @@ int nft_flow_route(const struct nft_pktinfo *pkt, const struct nf_conn *ct,
+ 		return -ENOENT;
+ 	}
+ 
++#if IS_ENABLED(CONFIG_XFRM)
++	sp = skb_sec_path(pkt->skb);
++	xo = xfrm_input_offload(pkt->skb);
++	if (sp && xo && (xo->flags & XFRM_HW_FLOW_ID)) {
++		struct xfrm_state *x = sp->xvec[sp->len - 1];
++
++		other_dst = xfrm_lookup(nft_net(pkt), other_dst, &fl, NULL, 0);
++		if (IS_ERR(other_dst)) {
++			dst_release(this_dst);
++			return -ENOENT;
++		}
++
++		xfrm_state_hold(x);
++		route->tuple[dir].xfrm_input = x;
++		route->tuple[dir].xfrm_input_flow_id = xo->hw_flow_id;
++		route->tuple[dir].xfrm_policy_genid = sp->policy_genid;
++		route->tuple[!dir].xfrm_policy_genid = sp->policy_genid;
++	}
++#endif
++
+ skip_l3:
+ 
+ 	nft_default_forward_path(route, this_dst, dir);
+ 	nft_default_forward_path(route, other_dst, !dir);
+ 
++#if IS_ENABLED(CONFIG_XFRM)
++	if (!route->tuple[dir].xfrm_input) {
++		if (nft_flow_route_needs_xfrm_input(route, !dir))
++			goto err_dst_release;
++
++		if (nft_flow_route_needs_xfrm_input(route, dir)) {
++			u32 genid;
++
++			/* Only an unmarked, locally initiated flow with a verified
++			 * output policy may precede its authenticated input path.
++			 */
++			if (dir != IP_CT_DIR_ORIGINAL || pkt->skb->mark ||
++			    !xfrm_policy_flowtable_eligible(nft_net(pkt)))
++				goto err_dst_release;
++
++			genid = xfrm_policy_generation(nft_net(pkt));
++			route->tuple[dir].xfrm_policy_genid = genid;
++			route->tuple[!dir].xfrm_policy_genid = genid;
++			route->tuple[!dir].xfrm_input_deferred = true;
++		}
++	}
++#endif
++
+ 	if (route->tuple[dir].xmit_type	== FLOW_OFFLOAD_XMIT_NEIGH &&
+ 	    route->tuple[!dir].xmit_type == FLOW_OFFLOAD_XMIT_NEIGH) {
+ 		if ((nft_dev_forward_path(pkt, is_bridging, route, ct, dir, dir, ft) ||
+@@ -361,5 +435,16 @@ skip_l3:
+ 	}
+ 
+ 	return 0;
++
++err_dst_release:
++	dst_release(route->tuple[dir].dst);
++	dst_release(route->tuple[!dir].dst);
++#if IS_ENABLED(CONFIG_XFRM)
++	if (route->tuple[dir].xfrm_input) {
++		xfrm_state_put(route->tuple[dir].xfrm_input);
++		route->tuple[dir].xfrm_input = NULL;
++	}
++#endif
++	return -ENOENT;
+ }
+ EXPORT_SYMBOL_GPL(nft_flow_route);
