diff --git a/target/linux/airoha/patches-6.18/9999-45-airoha-ppe-setup-tc-block-cb-signature.patch b/target/linux/airoha/patches-6.18/9999-45-airoha-ppe-setup-tc-block-cb-signature.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-45-airoha-ppe-setup-tc-block-cb-signature.patch
@@ -0,0 +1,65 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: XR1710G maintainer <maintainer@xr1710g.local>
+Date: Sat, 12 Sep 2026 17:40:00 +0800
+Subject: [PATCH] net: airoha: widen airoha_ppe_setup_tc_block_cb to 3 params
+
+The SOE series widened this callback across four places, but two of them live in
+patches that are still disabled, so the build broke twice in a row:
+
+  airoha_ppe.c:1748  conflicting types        (definition, SOE-25, disabled)
+  airoha_ppe.c:1886  incompatible pointer     (ops field,  SOE-24, disabled)
+
+Supply both disabled halves here, plus the inline helper body and its !CONFIG
+stub, which otherwise call the 3-arg pointer with 2 arguments.
+
+diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -1602,4 +1602,5 @@
+-int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data)
++int airoha_ppe_setup_tc_block_cb(struct airoha_ppe_dev *dev, void *type_data,
++				 __maybe_unused bool is_flowtable)
+ {
+ 	struct airoha_ppe *ppe = dev->priv;
+ 	struct airoha_eth *eth = ppe->eth;
+diff --git a/include/linux/soc/airoha/airoha_offload.h b/include/linux/soc/airoha/airoha_offload.h
+--- a/include/linux/soc/airoha/airoha_offload.h
++++ b/include/linux/soc/airoha/airoha_offload.h
+@@ -17,7 +17,8 @@ enum {
+ struct airoha_ppe_dev {
+ 	struct {
+ 		int (*setup_tc_block_cb)(struct airoha_ppe_dev *dev,
+-					 void *type_data);
++					 void *type_data,
++					 bool is_flowtable);
+ 		void (*check_skb)(struct airoha_ppe_dev *dev,
+ 				  struct sk_buff *skb, u16 hash,
+ 				  bool rx_wlan);
+@@ -33,7 +34,13 @@ void airoha_ppe_put_dev(struct airoha_ppe_dev *dev);
+ static inline int airoha_ppe_dev_setup_tc_block_cb(struct airoha_ppe_dev *dev,
+ 						   void *type_data)
+ {
+-	return dev->ops.setup_tc_block_cb(dev, type_data);
++	return dev->ops.setup_tc_block_cb(dev, type_data, false);
++}
++
++static inline int airoha_ppe_dev_setup_ft_block_cb(struct airoha_ppe_dev *dev,
++						   void *type_data)
++{
++	return dev->ops.setup_tc_block_cb(dev, type_data, true);
+ }
+ 
+ static inline void airoha_ppe_dev_check_skb(struct airoha_ppe_dev *dev,
+@@ -58,6 +65,12 @@ static inline int airoha_ppe_dev_setup_tc_block_cb(struct airoha_ppe_dev *dev,
+ 	return -EOPNOTSUPP;
+ }
+ 
++static inline int airoha_ppe_dev_setup_ft_block_cb(struct airoha_ppe_dev *dev,
++						   void *type_data)
++{
++	return -EOPNOTSUPP;
++}
++
+ static inline void airoha_ppe_dev_check_skb(struct airoha_ppe_dev *dev,
+ 					    struct sk_buff *skb, u16 hash,
+ 					    bool rx_wlan)
