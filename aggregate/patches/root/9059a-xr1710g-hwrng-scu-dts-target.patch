# Source: XR1710G self-held kernel patch -- 9059 的 target 树载体版 v3（F120 续，P28 修订）
# Reason: 9059 原补丁目标是内核树 arch/arm64/boot/dts/airoha/en7581.dtsi，而本板固件编译的是
#   target/linux/airoha/dts/an7581.dtsi（9001 板级 dts 的 include 按同目录优先解析，P27 坑 71）
#   ⇒ airoha,scu 从未进 DTB。本补丁在目标树 an7581.dtsi 给 rng 节点挂 airoha,scu 句柄。
# v3 关键：airoha,scu 直接指向**现成的 scuclk**（"airoha,en7581-scu","syscon"，reg=0x1fb00000/0x970，
#   窗口覆盖驱动要写的偏移 0x1e4/0x1ec/0x200/0x204）。v2 的 scuclk 内嵌 syscon@1e4 方案否决：
#   父节点无 #address-cells/#size-cells/ranges ⇒ of_address_to_resource 解析失败/错址 ⇒
#   syscon_regmap_lookup_by_phandle 返回 ERR ⇒ 9058 静默置 scu=NULL（等于没修）。
#   9059 内核侧（同源内嵌 syscon@1e4）同样缺陷，改 9058/9059 内核侧时一并修正（下轮）。
# 实证：GNU patch -p1 --fuzz=0 干净应用（链序 9001→9011→9059a→9059b 全模拟通过）；
#   本地复刻 CI cpp+dtc 编出 an7581-xr1710g-ubi.dtb，反编译确认 rng 节点 airoha,scu=<&scuclk>。
# 档位 #EXP：与 9059 同档同批；实机判据见 FIXES F120。
diff --git a/target/linux/airoha/dts/an7581.dtsi b/target/linux/airoha/dts/an7581.dtsi
index af5a5f4d..93c85b11 100644
--- a/target/linux/airoha/dts/an7581.dtsi
+++ b/target/linux/airoha/dts/an7581.dtsi
@@ -566,6 +566,12 @@
 			compatible = "airoha,en7581-trng";
 			reg = <0x0 0x1faa1000 0x0 0xc04>;
 			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+
+			/* TRNG gates live in SCU BUS/PER clock-gate registers; the
+			 * driver writes offsets 0x1e4/0x1ec/0x200 into this syscon
+			 * regmap (base = scuclk 0x1fb00000) before first access.
+			 */
+			airoha,scu = <&scuclk>;
 		};
 
 		usb0: usb@1fab0000 {
