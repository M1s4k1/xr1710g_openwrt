--- a/package/luci-app-airoha-flowsense/root/usr/libexec/rpcd/luci.airoha_flowsense
+++ b/package/luci-app-airoha-flowsense/root/usr/libexec/rpcd/luci.airoha_flowsense
@@ -465,10 +465,39 @@
 	' "$stats_file" 2>/dev/null || echo '{"bands":[]}'
