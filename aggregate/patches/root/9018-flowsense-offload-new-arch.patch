+_flow_offload_hw_enabled() {
+	local fo foh
+	fo=$(uci get firewall.@defaults[0].flow_offloading 2>/dev/null)
+	foh=$(uci get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)
+	[ "$fo" = "1" ] && [ "$foh" = "1" ]
+}
+
+_enable_flow_offload() {
+	uci set firewall.@defaults[0].flow_offloading='1'
+	uci set firewall.@defaults[0].flow_offloading_hw='1'
+	uci commit firewall
+	/etc/init.d/firewall reload >/dev/null 2>&1 &
+}
+
+_pppoe_offload_active() {
+	_flow_offload_hw_enabled || return 1
+	local wan_dev
+	wan_dev=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e "@.l3_device" 2>/dev/null)
+	case "$wan_dev" in pppoe-*) ;; *) return 1;; esac
+	nft -j list flowtables 2>/dev/null | grep -q "\"$wan_dev\""
+}
+
 get_vlan_offload() {
 	local val
-	val=$(cat /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null)
-	printf '{"enabled":%d}' "${val:-0}"
+	if val=$(cat /proc/sys/net/bridge/bridge-nf-filter-vlan-tagged 2>/dev/null); then
+		printf '{"enabled":%d}' "${val:-0}"
+		return
+	fi
+	if _flow_offload_hw_enabled; then
+		printf '{"enabled":1}'
+	else
+		printf '{"enabled":0}'
+	fi
 }
 
