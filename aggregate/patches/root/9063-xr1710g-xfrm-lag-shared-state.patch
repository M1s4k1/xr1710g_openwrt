+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] bonding: add shared-state XFRM offload
+
+Offload shared XFRM state through eligible LAG lower devices.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ drivers/net/bonding/bond_main.c | 890 ++++++++++++++++++++++++++------
+ 1 file changed, 745 insertions(+), 145 deletions(-)
+
+diff --git a/drivers/net/bonding/bond_main.c b/drivers/net/bonding/bond_main.c
+index 2d5095a..769467c 100644
+--- a/drivers/net/bonding/bond_main.c
++++ b/drivers/net/bonding/bond_main.c
+@@ -425,36 +425,156 @@ static int bond_vlan_rx_kill_vid(struct net_device *bond_dev,
+ /*---------------------------------- XFRM -----------------------------------*/
+ 
+ #ifdef CONFIG_XFRM_OFFLOAD
+-/**
+- * bond_ipsec_dev - Get active device for IPsec offload
+- * @xs: pointer to transformer state struct
+- *
+- * Context: caller must hold rcu_read_lock.
+- *
+- * Return: the device for ipsec offload, or NULL if not exist.
+- **/
+-static struct net_device *bond_ipsec_dev(struct xfrm_state *xs)
++static bool bond_ipsec_slave_has_xfrm_ops(struct net_device *real_dev)
+ {
+-	struct net_device *bond_dev = xs->xso.dev;
+-	struct bonding *bond;
+-	struct slave *slave;
++	const struct xfrmdev_ops *ops;
+ 
+-	bond = netdev_priv(bond_dev);
+-	if (BOND_MODE(bond) != BOND_MODE_ACTIVEBACKUP)
+-		return NULL;
++	if (!real_dev || netif_is_bond_master(real_dev))
++		return false;
+ 
+-	slave = rcu_dereference(bond->curr_active_slave);
+-	if (!slave)
+-		return NULL;
++	ops = READ_ONCE(real_dev->xfrmdev_ops);
+ 
+-	if (!xs->xso.real_dev)
+-		return NULL;
++	return ops && ops->xdo_dev_state_add &&
++	       ops->xdo_dev_state_delete && ops->xdo_dev_state_free;
++}
+ 
+-	if (xs->xso.real_dev != slave->dev)
+-		pr_warn_ratelimited("%s: (slave %s): not same with IPsec offload real dev %s\n",
+-				    bond_dev->name, slave->dev->name, xs->xso.real_dev->name);
++static bool bond_ipsec_lag_slave_capable(struct net_device *real_dev)
++{
++	const struct xfrmdev_ops *ops;
+ 
+-	return slave->dev;
++	if (!bond_ipsec_slave_has_xfrm_ops(real_dev) ||
++	    !((READ_ONCE(real_dev->features) |
++	       READ_ONCE(real_dev->hw_features)) & NETIF_F_HW_ESP))
++		return false;
++
++	ops = READ_ONCE(real_dev->xfrmdev_ops);
++
++	return (ops->flags & (XFRMDEV_OPS_F_LOWER_HANDLE |
++			      XFRMDEV_OPS_F_LAG_SHARED_STATE)) ==
++		       (XFRMDEV_OPS_F_LOWER_HANDLE |
++			XFRMDEV_OPS_F_LAG_SHARED_STATE) &&
++	       ops->xdo_dev_state_lag_compatible;
++}
++
++static bool bond_ipsec_lag_slave_ok(struct net_device *real_dev)
++{
++	return bond_ipsec_lag_slave_capable(real_dev) &&
++	       (READ_ONCE(real_dev->features) & NETIF_F_HW_ESP);
++}
++
++static bool bond_ipsec_lag_pair_capable(struct net_device *real_dev,
++					struct net_device *peer_dev)
++{
++	const struct xfrmdev_ops *peer_ops;
++	const struct xfrmdev_ops *ops;
++
++	if (!bond_ipsec_lag_slave_capable(real_dev) ||
++	    !bond_ipsec_lag_slave_capable(peer_dev))
++		return false;
++
++	ops = READ_ONCE(real_dev->xfrmdev_ops);
++	peer_ops = READ_ONCE(peer_dev->xfrmdev_ops);
++
++	return ops->xdo_dev_state_lag_compatible(real_dev, peer_dev) &&
++	       peer_ops->xdo_dev_state_lag_compatible(peer_dev, real_dev);
++}
++
++static bool bond_ipsec_lag_pair_ok(struct net_device *real_dev,
++				   struct net_device *peer_dev)
