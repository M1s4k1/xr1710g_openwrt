++	 * shared state with both the pinned lower and a current bond slave.
++	 */
++	slaves = rcu_dereference(bond->usable_slaves);
++	count = slaves ? READ_ONCE(slaves->count) : 0;
++	for (i = 0; i < count; i++) {
++		struct net_device *peer_dev = slaves->arr[i]->dev;
++
++		if (bond_ipsec_lag_pair_ok(real_dev, peer_dev) &&
++		    bond_ipsec_lag_pair_ok(peer_dev, lower_dev))
++			goto out;
++	}
++	handle = 0;
+ out:
+ 	rcu_read_unlock();
++
++	return handle;
++}
