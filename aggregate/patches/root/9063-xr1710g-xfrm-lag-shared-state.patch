++	bool has_usable_slaves;
++	bool disabling;
++	bool enabling;
++
++	if (!bond_mode_can_use_lag_xfrm(bond))
++		return 0;
++
++	changed = (READ_ONCE(dev->features) ^ features) & NETIF_F_HW_ESP;
++	if (!changed)
++		return 0;
++
++	enabling = features & NETIF_F_HW_ESP;
++	disabling = (READ_ONCE(dev->features) & NETIF_F_HW_ESP) &&
++		    !(features & NETIF_F_HW_ESP);
++	if (disabling) {
++		bond_ipsec_lag_begin_flush(bond);
++		xfrm_dev_state_flush(dev_net(dev), dev, true);
++	}
++
++	bond_for_each_slave(bond, slave, iter) {
++		int err;
++
++		if (!netif_running(slave->dev))
++			continue;
++		err = bond_set_slave_xfrm_features(bond, slave, features);
++		if (err)
++			slave_warn(dev, slave->dev,
++				   "failed to apply LAG XFRM feature request\n");
++	}
++
++	if (disabling)
++		bond_ipsec_lag_end_flush(bond);
++	if (enabling) {
++		rcu_read_lock();
++		slaves = rcu_dereference(bond->usable_slaves);
++		has_usable_slaves = slaves && READ_ONCE(slaves->count);
++		rcu_read_unlock();
++
++		if (has_usable_slaves && !bond_ipsec_lag_ready(bond))
++			return -EOPNOTSUPP;
++	}
++
++	return 0;
++}
++#endif
