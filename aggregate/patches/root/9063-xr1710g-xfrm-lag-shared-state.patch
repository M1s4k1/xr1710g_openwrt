++static int bond_ipsec_packet_xmit(struct sock *sk, struct sk_buff *skb,
++				  struct xfrm_state *xs)
++{
++	const struct xfrmdev_ops *ops = READ_ONCE(xs->xso.real_ops);
++	struct net_device *real_dev = READ_ONCE(xs->xso.real_dev);
++	int err = -EHOSTUNREACH;
++
++	if (!real_dev || !ops || !ops->xdo_dev_packet_xmit ||
++	    !netif_running(real_dev) ||
++	    !xfrm_dev_state_lower_handle(xs, real_dev))
++		goto drop;
++
++	skb->dev = real_dev;
++
++	return ops->xdo_dev_packet_xmit(sk, skb, xs);
++
++drop:
++	XFRM_INC_STATS(xs_net(xs), LINUX_MIB_XFRMOUTERROR);
++	kfree_skb(skb);
++	return err;
++}
