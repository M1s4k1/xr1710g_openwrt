+diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
+index 2f2fbf4ca9b7da8fc6d4a9ca1509225bac66db2e..273a2fcea309fca814e36e10947e3626eb356ade 100644
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -3423,6 +3423,13 @@
+ 			return -ENOENT;
+ 
+ 		if (!flow_block_cb_decref(block_cb)) {
++			/* issue #7 防御：flowtable teardown 时逐流 FLOW_CLS_DESTROY
++			 * 晚于 UNBIND 且 cb 已从 flowtable cb_list 摘除，驱动收不到
