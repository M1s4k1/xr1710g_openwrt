++/* airoha_ppe_offload_drain - flowtable teardown 后的 FOE 残留统一清理。
++ *
++ * 背景（issue #7）：nf_tables 销毁 hardware flowtable 时，FLOW_BLOCK_UNBIND
++ * 在 commit 中同步执行（flow_block_cb 随即被 core 释放），而逐流的
++ * FLOW_CLS_DESTROY 由异步 destroy_work（nf_flow_table_free）发出——落地时
++ * 遍历的 cb_list 已空，驱动永远收不到 DESTROY，NPU/PPE 固件侧 FOE 条目与
++ * 驱动侧 eth->flow_table 条目全部残留。
++ *
++ * 本函数把残留条目全部失效并释放：L2/L4 条目都挂在 eth->flow_table
++ * （e->node）；L4 另挂 ppe->foe_flow[]（e->list），L2 另挂 ppe->l2_flows
++ * （e->l2_node；e->l2_flows 上的子流只挂在父条目）。失效动作复用
++ * airoha_ppe_foe_commit_entry()——本树中该路径为 CPU 直写 FOE 缓冲/SRAM
++ * （openwrt 099-07），无 mail box、无 100s 轮询风险。
++ *
++ * 锁：必须持 flow_offload_mutex 调用（与 replace/destroy 互斥，本次调用
++ * 来自 airoha_ppe_setup_tc_block_cb）；函数内持 ppe_lock（与 RX 数据面互斥）。
++ * 注意：rhashtable walker 下一次迭代仍会跟随刚摘除节点保留的 ->next（
++ * __rhashtable_remove_fast_one 不回写节点自身），故释放统一推迟到 walk
++ * 结束之后；遍历中遇到 resize（-EAGAIN）时重建迭代器重新遍历（已摘除的
++ * 条目不会再被遇到）。
++ */
++static void airoha_ppe_offload_drain(struct airoha_eth *eth)
++{
++	struct airoha_flow_table_entry *e, *sub;
++	struct rhashtable_iter hti;
++	struct hlist_node *n;
++	HLIST_HEAD(dead);
++
++	if (!eth->ppe)
++		return;
++
++	spin_lock_bh(&ppe_lock);
++
++	rhashtable_walk_enter(&eth->flow_table, &hti);
++	rhashtable_walk_start(&hti);
++	while (true) {
++		e = rhashtable_walk_next(&hti);
++		if (!e)
++			break;
++		if (IS_ERR(e)) {
++			/* 表 resize：先 stop 释放 RCU 读锁，再重建迭代器从头重走
++			 * （已摘除条目不会重遇，walk_start 会重新校验位置）。 */
++			rhashtable_walk_stop(&hti);
++			rhashtable_walk_exit(&hti);
++			rhashtable_walk_enter(&eth->flow_table, &hti);
++			rhashtable_walk_start(&hti);
++			continue;
++		}
++
++		if (e->hash != 0xffff) {
++			e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
++			e->data.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
++						  AIROHA_FOE_STATE_INVALID);
++			airoha_ppe_foe_commit_entry(eth->ppe, &e->data,
++						    e->hash, false);
++			e->hash = 0xffff;
++		}
++
++		if (e->type == FLOW_TYPE_L2) {
++			rhashtable_remove_fast(&eth->ppe->l2_flows, &e->l2_node,
++					       airoha_l2_flow_table_params);
++			hlist_for_each_entry_safe(sub, n, &e->l2_flows,
++						  l2_subflow_node) {
++				if (sub->hash != 0xffff) {
++					sub->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
++					sub->data.ib1 |=
++						FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
++							   AIROHA_FOE_STATE_INVALID);
++					airoha_ppe_foe_commit_entry(eth->ppe,
++								    &sub->data,
++								    sub->hash,
++								    false);
++					sub->hash = 0xffff;
++				}
++				hlist_del_init(&sub->l2_subflow_node);
++				hlist_add_head(&sub->l2_subflow_node, &dead);
++			}
++		} else {
++			hlist_del_init(&e->list);
++		}
++		rhashtable_remove_fast(&eth->flow_table, &e->node,
++				       airoha_flow_table_params);
++		/* 用 l2_subflow_node 链入待释放链表：L4/L2 父条目该成员空闲 */
++		hlist_add_head(&e->l2_subflow_node, &dead);
++	}
++	rhashtable_walk_stop(&hti);
++	rhashtable_walk_exit(&hti);
++
++	hlist_for_each_entry_safe(e, n, &dead, l2_subflow_node)
++		kfree(e);
++
++	spin_unlock_bh(&ppe_lock);
++}
++
