++	err = ops->xdo_dev_state_add(dev, x, extack);
+ 	if (err) {
+ 		xso->dev = NULL;
+ 		xso->dir = 0;
++		xso->state_ops = NULL;
+ 		netdev_put(dev, &xso->dev_tracker);
+ 		xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
+ 
+@@ -351,6 +356,7 @@ int xfrm_dev_policy_add(struct net *net, struct xfrm_policy *xp,
+ 			struct xfrm_user_offload *xuo, u8 dir,
+ 			struct netlink_ext_ack *extack)
+ {
++	const struct xfrmdev_ops *ops;
+ 	struct xfrm_dev_offload *xdo = &xp->xdo;
+ 	struct net_device *dev;
+ 	int err;
+@@ -367,7 +373,8 @@ int xfrm_dev_policy_add(struct net *net, struct xfrm_policy *xp,
+ 	if (!dev)
+ 		return -EINVAL;
+ 
+-	if (!dev->xfrmdev_ops || !dev->xfrmdev_ops->xdo_dev_policy_add) {
++	ops = READ_ONCE(dev->xfrmdev_ops);
++	if (!ops || !ops->xdo_dev_policy_add) {
+ 		xdo->dev = NULL;
+ 		dev_put(dev);
+ 		NL_SET_ERR_MSG(extack, "Policy offload is not supported");
+@@ -394,7 +401,7 @@ int xfrm_dev_policy_add(struct net *net, struct xfrm_policy *xp,
+ 		return -EINVAL;
+ 	}
+ 
+-	err = dev->xfrmdev_ops->xdo_dev_policy_add(xp, extack);
++	err = ops->xdo_dev_policy_add(xp, extack);
+ 	if (err) {
+ 		xdo->dev = NULL;
+ 		xdo->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
+@@ -408,20 +415,119 @@ int xfrm_dev_policy_add(struct net *net, struct xfrm_policy *xp,
+ }
+ EXPORT_SYMBOL_GPL(xfrm_dev_policy_add);
+ 
++static bool xfrm_dev_offload_get_locked(struct xfrm_state *x)
++{
++	lockdep_assert_held(&x->lock);
++
++	if (x->km.state == XFRM_STATE_VALID && x->xso.dev &&
++	    atomic_inc_unless_negative(&x->xso.active_refs)) {
++		xfrm_state_hold(x);
++		return true;
++	}
++
++	return false;
++}
++
++bool xfrm_dev_offload_get(struct xfrm_state *x)
++{
++	bool held;
++
++	spin_lock_bh(&x->lock);
++	held = xfrm_dev_offload_get_locked(x);
++	spin_unlock_bh(&x->lock);
++
++	return held;
++}
++EXPORT_SYMBOL_GPL(xfrm_dev_offload_get);
++
++void xfrm_dev_offload_put(struct xfrm_state *x)
++{
++	atomic_dec_and_wake_up(&x->xso.active_refs);
++	xfrm_state_put(x);
++}
++EXPORT_SYMBOL_GPL(xfrm_dev_offload_put);
++
++void xfrm_dev_state_update_stats(struct xfrm_state *x)
++{
++	struct xfrm_dev_offload *xso = &x->xso;
++	const struct xfrmdev_ops *state_ops;
++	const struct xfrmdev_ops *ops;
++	struct net_device *dev;
++
++	/* The caller already pins x, but an unlocked dump still needs to keep
++	 * the device-private state alive against an early offload free.
++	 */
++	if (!atomic_inc_unless_negative(&xso->active_refs))
++		return;
++
++	dev = READ_ONCE(xso->dev);
++	state_ops = READ_ONCE(xso->state_ops);
++	if (dev && state_ops) {
++		ops = READ_ONCE(dev->xfrmdev_ops);
++		if (ops && ops == state_ops && ops->xdo_dev_state_update_stats)
++			ops->xdo_dev_state_update_stats(x);
++	}
++
++	atomic_dec_and_wake_up(&xso->active_refs);
++}
++EXPORT_SYMBOL_GPL(xfrm_dev_state_update_stats);
++
++void xfrm_dev_state_advance_esn(struct xfrm_state *x)
++{
++	struct xfrm_dev_offload *xso = &x->xso;
++	const struct xfrmdev_ops *state_ops;
++	const struct xfrmdev_ops *ops;
++	struct net_device *dev;
++
++	/* Replay updates run with x->lock held, so acquire only the private-state
++	 * lifetime reference here rather than recursing through the locking
++	 * xfrm_dev_offload_get() helper.
++	 */
++	if (!atomic_inc_unless_negative(&xso->active_refs))
++		return;
++
++	dev = READ_ONCE(xso->dev);
++	state_ops = READ_ONCE(xso->state_ops);
++	if (dev && state_ops) {
++		ops = READ_ONCE(dev->xfrmdev_ops);
++		if (ops && ops == state_ops && ops->xdo_dev_state_advance_esn)
++			ops->xdo_dev_state_advance_esn(x);
++	}
++
++	atomic_dec_and_wake_up(&xso->active_refs);
++}
