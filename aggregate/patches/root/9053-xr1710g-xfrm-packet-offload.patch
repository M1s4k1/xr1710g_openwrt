+ 		x1 = __xfrm_find_acq_byseq(net, mark, x->km.seq, x->pcpu_num);
+-		if (x1 && ((x1->id.proto != x->id.proto) ||
+-		    !xfrm_addr_equal(&x1->id.daddr, &x->id.daddr, family))) {
++		if (x1 && (x1->id.proto != x->id.proto ||
++			   !xfrm_addr_equal(&x1->id.daddr, &x->id.daddr,
++					    family))) {
+ 			to_put = x1;
+ 			x1 = NULL;
+ 		}
+@@ -2148,6 +2288,7 @@ struct xfrm_state *xfrm_state_migrate(struct xfrm_state *x,
+ 				      struct netlink_ext_ack *extack)
+ {
+ 	struct xfrm_state *xc;
++	int err;
+ 
+ 	xc = xfrm_state_clone_and_setup(x, encap, m);
+ 	if (!xc)
+@@ -2164,11 +2305,21 @@ struct xfrm_state *xfrm_state_migrate(struct xfrm_state *x,
+ 	if (xfrm_addr_equal(&x->id.daddr, &m->new_daddr, m->new_family)) {
+ 		/* a care is needed when the destination address of the
+ 		   state is to be updated as it is a part of triplet */
+-		xfrm_state_insert(xc);
++		spin_lock_bh(&net->xfrm.xfrm_state_lock);
++		if (xc->km.state != XFRM_STATE_DEAD &&
++		    xfrm_dev_state_offload_active(xc)) {
++			__xfrm_state_bump_genids(xc);
++			__xfrm_state_insert(xc);
++			err = 0;
++		} else {
++			err = -ENODEV;
++		}
++		spin_unlock_bh(&net->xfrm.xfrm_state_lock);
+ 	} else {
+-		if (xfrm_state_add(xc) < 0)
+-			goto error_add;
++		err = xfrm_state_add(xc);
+ 	}
++	if (err)
++		goto error_add;
+ 
+ 	return xc;
+ error_add:
+@@ -2190,8 +2341,17 @@ int xfrm_state_update(struct xfrm_state *x)
+ 	struct net *net = xs_net(x);
+ 
+ 	to_put = NULL;
++	x1 = NULL;
+ 
+ 	spin_lock_bh(&net->xfrm.xfrm_state_lock);
++	if (x->km.state == XFRM_STATE_DEAD) {
++		err = -EINVAL;
++		goto out;
++	}
++	if (!xfrm_dev_state_offload_active(x)) {
++		err = -ENODEV;
++		goto out;
++	}
+ 	x1 = __xfrm_state_locate(x, use_spi, x->props.family);
+ 
+ 	err = -ESRCH;
+@@ -2204,6 +2364,17 @@ int xfrm_state_update(struct xfrm_state *x)
+ 		goto out;
+ 	}
+ 
++	/* Packet-offload state lives in device-private hardware and there is no
++	 * update callback to keep it in sync with in-place changes below. A
++	 * stale hardware state can also retain autonomous forwarding entries.
++	 */
++	if (x1->km.state != XFRM_STATE_ACQ &&
++	    x1->xso.type == XFRM_DEV_OFFLOAD_PACKET) {
++		to_put = x1;
++		err = -EOPNOTSUPP;
++		goto out;
++	}
++
+ 	if (x1->km.state == XFRM_STATE_ACQ) {
+ 		if (x->dir && x1->dir != x->dir) {
+ 			to_put = x1;
+@@ -2314,6 +2485,17 @@ int xfrm_state_check_expire(struct xfrm_state *x)
+ }
+ EXPORT_SYMBOL(xfrm_state_check_expire);
+ 
++void xfrm_state_expire(struct xfrm_state *x)
++{
++	spin_lock_bh(&x->lock);
++	if (x->km.state == XFRM_STATE_VALID) {
++		x->km.state = XFRM_STATE_EXPIRED;
++		hrtimer_start(&x->mtimer, 0, HRTIMER_MODE_REL_SOFT);
++	}
++	spin_unlock_bh(&x->lock);
++}
++EXPORT_SYMBOL_GPL(xfrm_state_expire);
++
+ void xfrm_state_update_stats(struct net *net)
+ {
+ 	struct xfrm_state *x;
+@@ -2740,6 +2922,62 @@ static void xfrm_replay_timer_handler(struct timer_list *t)
+ 
+ static LIST_HEAD(xfrm_km_list);
+ 
++u32 xfrm_policy_generation(const struct net *net)
++{
++	return atomic_read(&net->xfrm.policy_genid);
++}
++EXPORT_SYMBOL_GPL(xfrm_policy_generation);
++
++bool xfrm_policy_flowtable_eligible(const struct net *net)
++{
++	return !atomic_read(&net->xfrm.policy_change_count) &&
++	       !atomic_read(&net->xfrm.policy_flowtable_unsafe);
++}
++EXPORT_SYMBOL_GPL(xfrm_policy_flowtable_eligible);
++
++static void xfrm_policy_generation_advance(struct net *net)
++{
++	/* Generation zero means that no authenticated policy snapshot is
++	 * attached to a flow, so skip it when the counter eventually wraps.
++	 */
++	if (!atomic_inc_return(&net->xfrm.policy_genid))
++		atomic_inc(&net->xfrm.policy_genid);
++}
++
++void xfrm_policy_change_begin(struct net *net)
++{
++	struct xfrm_mgr *km;
++
++	lockdep_assert_held(&net->xfrm.xfrm_policy_lock);
++	xfrm_policy_generation_advance(net);
++	if (atomic_inc_return(&net->xfrm.policy_change_count) != 1)
++		return;
++
++	rcu_read_lock();
++	list_for_each_entry_rcu(km, &xfrm_km_list, list)
++		if (km->policy_change_begin)
++			km->policy_change_begin(net);
++	rcu_read_unlock();
++}
++EXPORT_SYMBOL_GPL(xfrm_policy_change_begin);
++
++void xfrm_policy_change_end(struct net *net)
++{
++	struct xfrm_mgr *km;
++
++	lockdep_assert_held(&net->xfrm.xfrm_policy_lock);
++	xfrm_policy_generation_advance(net);
++	if (!atomic_dec_and_test(&net->xfrm.policy_change_count))
++		return;
++
++	rcu_read_lock();
++	list_for_each_entry_rcu(km, &xfrm_km_list, list)
++		if (km->policy_changed)
++			km->policy_changed(net);
++	rcu_read_unlock();
++}
++EXPORT_SYMBOL_GPL(xfrm_policy_change_end);
++
+ void km_policy_notify(struct xfrm_policy *xp, int dir, const struct km_event *c)
+ {
+ 	struct xfrm_mgr *km;
+@@ -3002,6 +3240,9 @@ int xfrm_user_policy(struct sock *sk, int optname, sockptr_t optval, int optlen)
+ 	err = -EINVAL;
+ 	rcu_read_lock();
+ 	list_for_each_entry_rcu(km, &xfrm_km_list, list) {
++		if (!km->compile_policy)
++			continue;
++
+ 		pol = km->compile_policy(sk, optname, data,
+ 					 optlen, &err);
+ 		if (err >= 0)
+
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] xfrm: preserve packet offload ownership on user updates
+
+Preserve packet-offload ownership while userspace updates XFRM state.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ net/xfrm/xfrm_user.c | 9 +++++++++
+ 1 file changed, 9 insertions(+)
+
+diff --git a/net/xfrm/xfrm_user.c b/net/xfrm/xfrm_user.c
+index 9ad6619..726440b 100644
+--- a/net/xfrm/xfrm_user.c
++++ b/net/xfrm/xfrm_user.c
+@@ -1000,6 +1000,7 @@ static struct xfrm_state *xfrm_state_construct(struct net *net,
+ 
+ error:
+ 	x->km.state = XFRM_STATE_DEAD;
++	xfrm_dev_state_delete(x);
+ 	xfrm_state_put(x);
+ error_no_put:
+ 	*errp = err;
+@@ -2501,6 +2502,10 @@ static int xfrm_set_default(struct sk_buff *skb, struct nlmsghdr *nlh,
+ 	struct net *net = sock_net(skb->sk);
+ 	struct xfrm_userpolicy_default *up = nlmsg_data(nlh);
+ 
++	spin_lock_bh(&net->xfrm.xfrm_policy_lock);
++	xfrm_policy_change_begin(net);
++	spin_unlock_bh(&net->xfrm.xfrm_policy_lock);
++
+ 	if (xfrm_userpolicy_is_valid(up->in))
+ 		WRITE_ONCE(net->xfrm.policy_default[XFRM_POLICY_IN], up->in);
+ 
+@@ -2512,6 +2517,10 @@ static int xfrm_set_default(struct sk_buff *skb, struct nlmsghdr *nlh,
+ 
+ 	rt_genid_bump_all(net);
+ 
++	spin_lock_bh(&net->xfrm.xfrm_policy_lock);
++	xfrm_policy_change_end(net);
++	spin_unlock_bh(&net->xfrm.xfrm_policy_lock);
++
+ 	xfrm_notify_userpolicy(net);
+ 	return 0;
+ }
