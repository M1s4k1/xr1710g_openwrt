+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] xfrm: harden packet offload state lifetime
+
+Keep packet-offloaded XFRM state lifetime and teardown synchronized.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ net/xfrm/xfrm_state.c | 359 +++++++++++++++++++++++++++++++++++-------
+ 1 file changed, 300 insertions(+), 59 deletions(-)
+
+diff --git a/net/xfrm/xfrm_state.c b/net/xfrm/xfrm_state.c
+index 89daad5..d63d689 100644
+--- a/net/xfrm/xfrm_state.c
++++ b/net/xfrm/xfrm_state.c
+@@ -15,6 +15,7 @@
+  */
+ 
+ #include <linux/compat.h>
++#include <linux/wait_bit.h>
+ #include <linux/workqueue.h>
+ #include <net/xfrm.h>
+ #include <linux/pfkeyv2.h>
+@@ -58,6 +59,33 @@ static inline bool xfrm_state_hold_rcu(struct xfrm_state __rcu *x)
+ 	return refcount_inc_not_zero(&x->refcnt);
+ }
+ 
++/* Called with net->xfrm.xfrm_state_lock held. */
++static bool xfrm_dev_state_offload_active(struct xfrm_state *x)
++{
++	lockdep_assert_held(&xs_net(x)->xfrm.xfrm_state_lock);
++
++#ifdef CONFIG_XFRM_OFFLOAD
++	const struct xfrmdev_ops *ops;
++	struct net_device *dev;
++
++	if (x->xso.type != XFRM_DEV_OFFLOAD_PACKET)
++		return true;
++
++	dev = READ_ONCE(x->xso.dev);
++	if (!dev || !net_eq(dev_net(dev), xs_net(x)) ||
++	    READ_ONCE(dev->reg_state) != NETREG_REGISTERED ||
++	    READ_ONCE(dev->moving_ns) ||
++	    !(READ_ONCE(dev->features) & NETIF_F_HW_ESP))
++		return false;
++
++	ops = READ_ONCE(dev->xfrmdev_ops);
++	return ops && ops == READ_ONCE(x->xso.state_ops) &&
++	       ops->xdo_dev_state_add;
++#else
++	return true;
++#endif
++}
++
+ static inline unsigned int xfrm_dst_hash(struct net *net,
+ 					 const xfrm_address_t *daddr,
+ 					 const xfrm_address_t *saddr,
+@@ -737,6 +765,7 @@ struct xfrm_state *xfrm_state_alloc(struct net *net)
+ 	if (x) {
+ 		write_pnet(&x->xs_net, net);
+ 		refcount_set(&x->refcnt, 1);
++		atomic_set(&x->xso.active_refs, 0);
+ 		atomic_set(&x->tunnel_users, 0);
+ 		INIT_LIST_HEAD(&x->km.all);
+ 		INIT_HLIST_NODE(&x->state_cache);
+@@ -763,37 +792,93 @@ struct xfrm_state *xfrm_state_alloc(struct net *net)
+ EXPORT_SYMBOL(xfrm_state_alloc);
+ 
+ #ifdef CONFIG_XFRM_OFFLOAD
+-void xfrm_dev_state_delete(struct xfrm_state *x)
++static struct net_device *
++xfrm_dev_state_delete_prepare(struct xfrm_state *x,
++			      const struct xfrmdev_ops **ops)
+ {
+ 	struct xfrm_dev_offload *xso = &x->xso;
+-	struct net_device *dev = READ_ONCE(xso->dev);
++	struct net_device *dev;
++
++	if (WARN_ON_ONCE(!atomic_inc_unless_negative(&xso->active_refs)))
++		return NULL;
++	xfrm_state_hold(x);
++	dev = READ_ONCE(xso->dev);
++	if (!dev) {
++		xfrm_dev_offload_put(x);
++		return NULL;
++	}
+ 
+-	if (dev) {
+-		dev->xfrmdev_ops->xdo_dev_state_delete(dev, x);
+-		spin_lock_bh(&xfrm_state_dev_gc_lock);
+-		hlist_add_head(&x->dev_gclist, &xfrm_state_dev_gc_list);
++	/* Keep device-private state alive until its delete callback returns. */
++	spin_lock_bh(&xfrm_state_dev_gc_lock);
++	if (!hlist_unhashed(&x->dev_gclist)) {
+ 		spin_unlock_bh(&xfrm_state_dev_gc_lock);
++		xfrm_dev_offload_put(x);
++		return NULL;
+ 	}
++	hlist_add_head(&x->dev_gclist, &xfrm_state_dev_gc_list);
++	spin_unlock_bh(&xfrm_state_dev_gc_lock);
++	*ops = READ_ONCE(xso->state_ops);
++
++	return dev;
++}
++
++static void xfrm_dev_state_delete_finish(struct xfrm_state *x,
++					 struct net_device *dev,
++					 const struct xfrmdev_ops *ops)
++{
++	if (ops && ops->xdo_dev_state_delete)
++		ops->xdo_dev_state_delete(dev, x);
++	xfrm_dev_offload_put(x);
++}
++
++void xfrm_dev_state_delete(struct xfrm_state *x)
++{
++	const struct xfrmdev_ops *ops = NULL;
++	struct net_device *dev;
++
++	dev = xfrm_dev_state_delete_prepare(x, &ops);
++	if (dev)
++		xfrm_dev_state_delete_finish(x, dev, ops);
+ }
+ EXPORT_SYMBOL_GPL(xfrm_dev_state_delete);
+ 
+ void xfrm_dev_state_free(struct xfrm_state *x)
+ {
++	const struct xfrmdev_ops *ops;
+ 	struct xfrm_dev_offload *xso = &x->xso;
+-	struct net_device *dev = READ_ONCE(xso->dev);
++	struct net_device *dev;
+ 
+-	if (dev && dev->xfrmdev_ops) {
+-		spin_lock_bh(&xfrm_state_dev_gc_lock);
+-		if (!hlist_unhashed(&x->dev_gclist))
+-			hlist_del(&x->dev_gclist);
+-		spin_unlock_bh(&xfrm_state_dev_gc_lock);
++	/* Negative active_refs grants one caller exclusive free ownership.
++	 * Contenders wait for the owner to finish before checking xso.dev again.
++	 */
++	for (;;) {
++		if (!atomic_cmpxchg(&xso->active_refs, 0, -1))
++			break;
+ 
+-		if (dev->xfrmdev_ops->xdo_dev_state_free)
+-			dev->xfrmdev_ops->xdo_dev_state_free(dev, x);
+-		WRITE_ONCE(xso->dev, NULL);
+-		xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
+-		netdev_put(dev, &xso->dev_tracker);
++		wait_var_event(&xso->active_refs,
++			       !atomic_read(&xso->active_refs));
+ 	}
++
++	dev = READ_ONCE(xso->dev);
++	if (!dev)
++		goto release;
++
++	ops = READ_ONCE(xso->state_ops);
++	if (ops && ops->xdo_dev_state_free)
++		ops->xdo_dev_state_free(dev, x);
++
++	spin_lock_bh(&xfrm_state_dev_gc_lock);
++	if (!hlist_unhashed(&x->dev_gclist))
++		hlist_del_init(&x->dev_gclist);
++	WRITE_ONCE(xso->dev, NULL);
++	WRITE_ONCE(xso->state_ops, NULL);
++	xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
++	spin_unlock_bh(&xfrm_state_dev_gc_lock);
++	netdev_put(dev, &xso->dev_tracker);
++
++release:
++	atomic_set_release(&xso->active_refs, 0);
++	wake_up_var(&xso->active_refs);
+ }
+ #endif
+ 
+@@ -811,6 +896,10 @@ EXPORT_SYMBOL(__xfrm_state_destroy);
+ int __xfrm_state_delete(struct xfrm_state *x)
+ {
+ 	struct net *net = xs_net(x);
++#ifdef CONFIG_XFRM_OFFLOAD
++	const struct xfrmdev_ops *delete_ops = NULL;
++	struct net_device *delete_dev = NULL;
++#endif
+ 	int err = -ESRCH;
+ 
+ 	if (x->km.state != XFRM_STATE_DEAD) {
+@@ -831,9 +920,18 @@ int __xfrm_state_delete(struct xfrm_state *x)
+ 			hlist_del_init_rcu(&x->byspi);
+ 		net->xfrm.state_num--;
+ 		xfrm_nat_keepalive_state_updated(x);
++#ifdef CONFIG_XFRM_OFFLOAD
++		/* Device teardown must find the state in either the SAD or the
++		 * device-GC list, with no gap between the two.
++		 */
++		delete_dev = xfrm_dev_state_delete_prepare(x, &delete_ops);
++#endif
+ 		spin_unlock(&net->xfrm.xfrm_state_lock);
+ 
+-		xfrm_dev_state_delete(x);
++#ifdef CONFIG_XFRM_OFFLOAD
++		if (delete_dev)
++			xfrm_dev_state_delete_finish(x, delete_dev, delete_ops);
++#endif
+ 
+ 		xfrm_state_delete_tunnel(x);
+ 
+@@ -1006,8 +1104,15 @@ int xfrm_dev_state_flush(struct net *net, struct net_device *dev, bool task_vali
+ 		xso = &x->xso;
+ 
+ 		if (xso->dev == dev) {
++			if (!xfrm_state_hold_rcu(x)) {
++				spin_unlock_bh(&xfrm_state_dev_gc_lock);
++				xfrm_flush_gc();
++				spin_lock_bh(&xfrm_state_dev_gc_lock);
++				goto restart_gc;
++			}
+ 			spin_unlock_bh(&xfrm_state_dev_gc_lock);
+ 			xfrm_dev_state_free(x);
++			xfrm_state_put(x);
+ 			spin_lock_bh(&xfrm_state_dev_gc_lock);
+ 			goto restart_gc;
+ 		}
+@@ -1360,6 +1465,7 @@ xfrm_state_find(const xfrm_address_t *daddr, const xfrm_address_t *saddr,
+ {
+ 	static xfrm_address_t saddr_wildcard = { };
+ 	struct xfrm_hash_state_ptrs state_ptrs;
++	struct hlist_head *state_list;
+ 	struct net *net = xp_net(pol);
+ 	unsigned int h, h_wildcard;
+ 	struct xfrm_state *x, *x0, *to_put;
+@@ -1540,6 +1646,7 @@ xfrm_state_find(const xfrm_address_t *daddr, const xfrm_address_t *saddr,
+ 		}
+ #ifdef CONFIG_XFRM_OFFLOAD
+ 		if (pol->xdo.type == XFRM_DEV_OFFLOAD_PACKET) {
++			const struct xfrmdev_ops *ops;
+ 			struct xfrm_dev_offload *xdo = &pol->xdo;
+ 			struct xfrm_dev_offload *xso = &x->xso;
+ 			struct net_device *dev = xdo->dev;
+@@ -1547,12 +1654,19 @@ xfrm_state_find(const xfrm_address_t *daddr, const xfrm_address_t *saddr,
+ 			xso->type = XFRM_DEV_OFFLOAD_PACKET;
+ 			xso->dir = xdo->dir;
+ 			xso->dev = dev;
++			xso->ifindex = dev->ifindex;
+ 			xso->flags = XFRM_DEV_OFFLOAD_FLAG_ACQ;
+ 			netdev_hold(dev, &xso->dev_tracker, GFP_ATOMIC);
+-			error = dev->xfrmdev_ops->xdo_dev_state_add(dev, x,
+-								    NULL);
++			ops = READ_ONCE(dev->xfrmdev_ops);
++			if (!ops || !ops->xdo_dev_state_add) {
++				error = -ENODEV;
++			} else {
++				xso->state_ops = ops;
++				error = ops->xdo_dev_state_add(dev, x, NULL);
++			}
+ 			if (error) {
+ 				xso->dir = 0;
++				xso->state_ops = NULL;
+ 				netdev_put(dev, &xso->dev_tracker);
+ 				xso->dev = NULL;
+ 				xso->type = XFRM_DEV_OFFLOAD_UNSPECIFIED;
+@@ -1563,52 +1677,68 @@ xfrm_state_find(const xfrm_address_t *daddr, const xfrm_address_t *saddr,
+ 			}
+ 		}
+ #endif
+-		if (km_query(x, tmpl, pol) == 0) {
++		error = km_query(x, tmpl, pol) ? -ESRCH : 0;
++		if (!error) {
+ 			spin_lock_bh(&net->xfrm.xfrm_state_lock);
+-			x->km.state = XFRM_STATE_ACQ;
+-			x->dir = XFRM_SA_DIR_OUT;
+-			list_add(&x->km.all, &net->xfrm.state_all);
+-			h = xfrm_dst_hash(net, daddr, saddr, tmpl->reqid, encap_family);
+-			XFRM_STATE_INSERT(bydst, &x->bydst,
+-					  net->xfrm.state_bydst + h,
+-					  x->xso.type);
+-			h = xfrm_src_hash(net, daddr, saddr, encap_family);
+-			XFRM_STATE_INSERT(bysrc, &x->bysrc,
+-					  net->xfrm.state_bysrc + h,
+-					  x->xso.type);
+-			INIT_HLIST_NODE(&x->state_cache);
+-			if (x->id.spi) {
+-				h = xfrm_spi_hash(net, &x->id.daddr, x->id.spi, x->id.proto, encap_family);
+-				XFRM_STATE_INSERT(byspi, &x->byspi,
+-						  net->xfrm.state_byspi + h,
++			if (!xfrm_dev_state_offload_active(x)) {
++				error = -ENODEV;
++			} else {
++				x->km.state = XFRM_STATE_ACQ;
++				x->dir = XFRM_SA_DIR_OUT;
++				list_add(&x->km.all, &net->xfrm.state_all);
++				h = xfrm_dst_hash(net, daddr, saddr,
++						  tmpl->reqid, encap_family);
++				state_list = net->xfrm.state_bydst + h;
++				XFRM_STATE_INSERT(bydst, &x->bydst,
++						  state_list,
+ 						  x->xso.type);
+-			}
+-			if (x->km.seq) {
+-				h = xfrm_seq_hash(net, x->km.seq);
+-				XFRM_STATE_INSERT(byseq, &x->byseq,
+-						  net->xfrm.state_byseq + h,
++				h = xfrm_src_hash(net, daddr, saddr,
++						  encap_family);
++				state_list = net->xfrm.state_bysrc + h;
++				XFRM_STATE_INSERT(bysrc, &x->bysrc,
++						  state_list,
+ 						  x->xso.type);
++				INIT_HLIST_NODE(&x->state_cache);
++				if (x->id.spi) {
++					h = xfrm_spi_hash(net, &x->id.daddr,
++							  x->id.spi,
++							  x->id.proto,
++							  encap_family);
++					state_list = net->xfrm.state_byspi + h;
++					XFRM_STATE_INSERT(byspi, &x->byspi,
++							  state_list,
++							  x->xso.type);
++				}
