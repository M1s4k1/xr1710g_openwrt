# Source: naoki66 09feeff + d3a0fa1 (622/743/744, XR1710G RTK SerDes/SDS bundle) and
#   YYH b74553b (743/744 semantics), rebuilt on openwrt main 6.18 (74eb10e) realtek driver.
# Upstream: n/a / open (743 body links openwrt 46d81ac). #EXP until validated on hardware.
# Reason: XR1710G 10G host SerDes needs a board-specific SDS mode (realtek,sds-mode=0x88c6,
#   LAN2), an opt-in RTK SerDes firmware-table supplement (realtek,patch-rtk-serdes, two
#   PSDS0 flow_s ops), and a copper-AN retry state machine (744) that re-pulses the flow_s
#   values with 10-12 ms hold and netdev-carrier feedback. 9001 dts opts both 10G PHYs in.
# 内层应用顺序 = 文件名排序 742 -> 743 -> 744（openwrt patch-kernel 语义）。

diff --git a/target/linux/airoha/patches-6.18/742-net-phy-realtek-allow-board-specific-RTL826x-SDS-mode.patch b/target/linux/airoha/patches-6.18/742-net-phy-realtek-allow-board-specific-RTL826x-SDS-mode.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/742-net-phy-realtek-allow-board-specific-RTL826x-SDS-mode.patch
@@ -0,0 +1,91 @@
+# Source: naoki66/ImmortalWrt-for-Gemtek-XR1710G 09feeff (622, RTL826x SDS mode, Linux 6.18.44 fix)
+# Upstream: n/a (community fork of openwrt master; property realtek,sds-mode is XR1710G board-specific)
+# Reason: XR1710G LAN2 (phy5) host-SerDes needs SDS page6 reg3=0x88c6 which vendor U-Boot
+#   programs but the common Linux RTL826x init leaves unset. Opt-in via realtek,sds-mode,
+#   applied in config_init after the firmware patch table (which resets the SerDes block).
+#   Rebuilt against openwrt main 6.18 (74eb10e): rtl826x_phy_patch_sds_set is already
+#   non-static and declared in phy_patch_rtl826x.h, so the naoki66 header/export hunks are
+#   dropped (they would be duplicates); hunks regenerated with consistent counts.
+
+From: naoki66 <naoki66@qq.com>
+Subject: [PATCH] net: phy: realtek: allow board-specific RTL826x SDS mode
+
+The RTL826x firmware tables are shared by several PHY variants and boards,
+so board-specific host-side SerDes setup does not belong in those tables.
+
+Allow a board to provide the value for the RTL826x host-side SDS mode
+register through the optional realtek,sds-mode property. Apply it after
+the common firmware table, since the table loader resets and initializes
+the SerDes block.
+
+This is needed on the Gemtek XR1710G LAN2 path. Its vendor U-Boot writes
+SDS page 6 register 3 to 0x88c6, while the common Linux initialization
+sequence currently leaves that board setting out.
+
+Signed-off-by: naoki66 <naoki66@qq.com>
+
+---
+diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
+index 3ae887d..5e332c7 100644
+--- a/drivers/net/phy/realtek/realtek_main.c
++++ b/drivers/net/phy/realtek/realtek_main.c
+@@ -245,6 +245,9 @@
+ #define RTL826X_VEND1_VERSION_ID		0x104
+ #define   RTL826X_VEND1_VERSION_ID_VARIANT	GENMASK(2, 0)
+ 
++#define RTL826X_SDS_HOST_MODE_PAGE		6
++#define RTL826X_SDS_HOST_MODE_REG		3
++
+ #define RTL826X_VND2_INER			0xA424
+ #define   RTL826X_VND2_INER_LINK_STATUS		BIT(4)
+ #define   RTL826X_VND2_INER_PME			BIT(7)
+@@ -2635,6 +2638,38 @@ static int rtl826x_probe(struct phy_device *phydev)
+ 	return 0;
+ }
+ 
++static int rtl826x_config_sds_mode(struct phy_device *phydev)
++{
++	struct device *dev = &phydev->mdio.dev;
++	u32 mode;
++	int ret;
++
++	if (!device_property_present(dev, "realtek,sds-mode"))
++		return 0;
++
++	ret = device_property_read_u32(dev, "realtek,sds-mode", &mode);
++	if (ret) {
++		phydev_err(phydev, "failed to read SDS mode: %d\n", ret);
++		return ret;
++	}
++
++	if (mode > 0xffff) {
++		phydev_err(phydev, "invalid SDS mode 0x%x\n", mode);
++		return -EINVAL;
++	}
++
++	ret = rtl826x_phy_patch_sds_set(phydev, RTL826X_SDS_HOST_MODE_PAGE,
++					RTL826X_SDS_HOST_MODE_REG, mode);
++	if (ret) {
++		phydev_err(phydev, "failed to set SDS mode 0x%04x: %d\n", mode, ret);
++		return ret;
++	}
++
++	phydev_info(phydev, "configured SDS mode 0x%04x\n", mode);
++
++	return 0;
++}
++
+ static int rtl826x_config_serdes_polarity(struct phy_device *phydev)
+ {
+ 	struct device *dev = &phydev->mdio.dev;
+@@ -2711,6 +2746,10 @@ static int rtl826x_config_init(struct phy_device *phydev)
+ 		return ret;
+ 	}
+ 
++	ret = rtl826x_config_sds_mode(phydev);
++	if (ret)
++		return ret;
++
+ 	return rtl826x_config_serdes_polarity(phydev);
+ }
+ 
diff --git a/target/linux/airoha/patches-6.18/743-net-phy-realtek-restore-optional-RTK-SerDes-patch.patch b/target/linux/airoha/patches-6.18/743-net-phy-realtek-restore-optional-RTK-SerDes-patch.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/743-net-phy-realtek-restore-optional-RTK-SerDes-patch.patch
@@ -0,0 +1,127 @@
+# Source: openwrt commit 46d81ac28caf2e0018089da921e9ae953f6dd3d2 (Balázs Triszka) +
+#   YYH b74553b adaptation to flex-array/little-endian patch DB; context refreshed on
+#   naoki66 d3a0fa1 for the 6.18.44 realtek driver (same semantics, KB-matching context)
+# Upstream: open (openwrt 46d81ac; PR follow-up pending validation)
+# Reason: restore opt-in realtek,patch-rtk-serdes: append two PSDS0 flow_s tuning ops
+#   (SDS 7.0x10->0x80aa, SDS 6.0x12->0x5078) after the common firmware table and drop the
+#   duplicate DTE XS reset; the second reset cleared firmware-programmed SDS 6.0x0d/0x0e/0x1d
+#   bits and left the AN7581 without a USXGMII partner word on affected XR1710G boards.
+
+From: Balázs Triszka <info@balika011.hu>
+Date: Sat, 18 Oct 2025 18:13:28 +0200
+Subject: [PATCH] net: phy: realtek: restore optional RTK SerDes patch
+
+The Realtek SDK applies two additional host SerDes writes on platforms
+which require the RTK SerDes tuning sequence. Support for selecting this
+sequence was present in the original RTL826x driver conversion, but was
+not retained when the driver was integrated for Linux 6.18.
+
+Restore the board opt-in realtek,patch-rtk-serdes property and append the
+two PSDS0 tuning operations after the common firmware patch table. Keep
+the sequence opt-in because it is not valid for every RTL826x host.
+
+Do not reset the DTE XS after applying the firmware table.
+rtl826x_config_init() already performs the vendor 0x145 reset before
+rtlgen_phy_patch(), matching the original driver order. A second reset at
+the end of the table was found to clear firmware-programmed SDS 6.0x0d,
+6.0x0e, and 6.0x1d bits. The PHY then reached Base-R block lock while the
+AN7581 received no USXGMII partner word. Restoring those firmware values
+and reapplying the two flow_s writes immediately raised AN_STATS_0 and
+carrier on the affected XR1710G.
+
+On the same board, the flow_s values change SDS 7.0x10 from 0x8003 to
+0x80aa and SDS 6.0x12 from 0x00a4 to 0x5078. Repeated positive, negative,
+and positive tests showed that these adjusted values eliminate the original
+load-dependent retransmission stalls.
+
+Link: https://github.com/openwrt/openwrt/commit/46d81ac28caf2e0018089da921e9ae953f6dd3d2
+Signed-off-by: Balázs Triszka <info@balika011.hu>
+[yyh: adapt the optional operations to the flex-array, little-endian patch database and preserve the vendor reset-before-patch ordering]
+Assisted-by: Codex:GPT-5.6-sol
+Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
+
+---
+diff --git a/drivers/net/phy/realtek/phy_patch_rtl826x.c b/drivers/net/phy/realtek/phy_patch_rtl826x.c
+index e3e45b7..7bf10f0 100644
+--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
++++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
+@@ -230,7 +230,7 @@ static int rtl826x_phy_patch_db_init(struct phy_device *phydev, const char *fw_n
+ 	struct rtlgen_phy_patch_db *patch_db;
+ 	struct rtlgen_hwpatch *patches;
+ 	const struct firmware *fw;
+-	size_t count;
++	size_t count, extra_count, total_count;
+ 	int ret;
+ 
+ 	ret = request_firmware_direct(&fw, fw_name, dev);
+@@ -253,17 +253,43 @@ static int rtl826x_phy_patch_db_init(struct phy_device *phydev, const char *fw_n
+ 
+ 	patches = (struct rtlgen_hwpatch *)fw->data;
+ 	count = fw->size / sizeof(*patches);
++	extra_count = priv->patch_rtk_serdes ? 2 : 0;
++	if (check_add_overflow(count, extra_count, &total_count)) {
++		ret = -EOVERFLOW;
++		goto out;
++	}
+ 
+-	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, count), GFP_KERNEL);
++	patch_db = devm_kzalloc(dev, struct_size(patch_db, conf, total_count),
++				GFP_KERNEL);
+ 	if (!patch_db) {
+ 		ret = -ENOMEM;
+ 		goto out;
+ 	}
+ 
+-	patch_db->count = count;
++	patch_db->count = total_count;
+ 	patch_db->patch_op_exec = rtl826x_phy_patch_op;
+ 
+ 	memcpy(patch_db->conf, patches, flex_array_size(patch_db, conf, count));
++	if (priv->patch_rtk_serdes) {
++		patch_db->conf[count] = (struct rtlgen_hwpatch) {
++			.patch_op = RTK_PATCH_OP_PSDS0,
++			.portmask = 0xff,
++			.pagemmd = cpu_to_le16(0x07),
++			.addr = cpu_to_le16(0x10),
++			.msb = 15,
++			.lsb = 0,
++			.data = cpu_to_le16(0x80aa),
++		};
++		patch_db->conf[count + 1] = (struct rtlgen_hwpatch) {
++			.patch_op = RTK_PATCH_OP_PSDS0,
++			.portmask = 0xff,
++			.pagemmd = cpu_to_le16(0x06),
++			.addr = cpu_to_le16(0x12),
++			.msb = 15,
++			.lsb = 0,
++			.data = cpu_to_le16(0x5078),
++		};
++	}
+ 
+ 	priv->patch = patch_db;
+ 
+diff --git a/drivers/net/phy/realtek/realtek.h b/drivers/net/phy/realtek/realtek.h
+index c59089a..6ec56d7 100644
+--- a/drivers/net/phy/realtek/realtek.h
++++ b/drivers/net/phy/realtek/realtek.h
+@@ -11,6 +11,7 @@
+ struct rtl826x_priv {
+ 	struct rtlgen_phy_patch_db *patch;
+ 	bool enable_pma_low_power:1;
++	bool patch_rtk_serdes:1;
+ 	struct phy_device *phydev;
+ 	struct delayed_work sds_work;
+ 	bool sds_work_disabled;
+diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
+index 5e332c7..0061215 100644
+--- a/drivers/net/phy/realtek/realtek_main.c
++++ b/drivers/net/phy/realtek/realtek_main.c
+@@ -2613,6 +2613,8 @@ static int rtl826x_probe(struct phy_device *phydev)
+ 		return -ENOMEM;
+ 
+ 	priv->enable_pma_low_power = device_property_read_bool(dev, "realtek,enable-pma-low-power");
++	priv->patch_rtk_serdes =
++		device_property_read_bool(dev, "realtek,patch-rtk-serdes");
+ 	priv->phydev = phydev;
+ 	phydev->priv = priv;
+ 
diff --git a/target/linux/airoha/patches-6.18/744-net-phy-realtek-reapply-RTK-SerDes-after-aneg.patch b/target/linux/airoha/patches-6.18/744-net-phy-realtek-reapply-RTK-SerDes-after-aneg.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/744-net-phy-realtek-reapply-RTK-SerDes-after-aneg.patch
@@ -0,0 +1,293 @@
+# Source: YYH b74553b (Yanghan Ye, XR1710G host SerDes stabilization) as refreshed on
+#   naoki66 d3a0fa1 for the Linux 6.18.44 realtek driver; rebuilt hunks on openwrt main 6.18
+# Upstream: n/a (community patch; keep #EXP until validated across reboots)
+# Reason: copper C45 AN can leave the RTL826x host-SerDes flow_s values ineffective while
+#   the PHY reports a completed copper link; the AN7581 USXGMII PCS then sees no partner
+#   word/carrier. Re-pulse SDS 7.0x10 0x8003 (10-12 ms) -> 0x80aa and SDS 6.0x12 -> 0x5078
+#   after each AN cycle, gated by netdev carrier feedback (120-poll grace window).
+
+From: Yanghan Ye <yyh94306@gmail.com>
+Date: Fri, 28 Aug 2026 12:00:00 +0800
+Subject: [PATCH] net: phy: realtek: retry RTK SerDes until carrier
+
+The optional RTL826x host-SerDes flow_s values can become ineffective
+when copper Clause 45 auto-negotiation starts. The PHY can then report a
+completed copper link while the connected AN7581 USXGMII PCS receives no
+partner word or carrier.
+
+After copper AN, pulse SDS 7.0x10 through 0x8003 before restoring the
+board's final 0x80aa value, then restore SDS 6.0x12 to 0x5078. Keep the
+intermediate value active for 10--12 ms. On the affected XR1710G,
+zero-delay pulses repeatedly left AN_STATS_0 at zero. Holding 0x8003 for
+one second, and then for only 10 ms on a separate cold boot, raised
+AN_STATS_0 and established 2.5G carrier. The Realtek firmware table also
+naturally performs about 96 patch operations between programming 0x8003
+and appending 0x80aa.
+
+Neither a single early pulse nor the RTL8261 DTE XS and SDS link bits
+prove that the outgoing in-band word reached the MAC PCS. A failing cold
+boot had both PHY-side bits set while AN_STATS_0 and netdev carrier
+remained zero.
+
+Close the loop using the attached netdev's generic carrier feedback. For
+each new copper AN cycle, pulse the SerDes and leave the copper PHY link
+published so phylink can observe the PCS. Keep it published while netdev
+carrier is down for a grace window of complete PCS polling rounds, then
+pulse again if needed. Stop retrying only after netdev carrier is up, and
+restart the sequence if carrier later drops while copper remains up.
+
+This does not read Airoha MMIO or add a retry limit, DTE XS or PCS reset,
+TXPLL reset, or TX FIR default.
+
+Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
+Assisted-by: Codex:GPT-5.6-sol
+
+---
+diff --git a/drivers/net/phy/realtek/phy_patch_rtl826x.c b/drivers/net/phy/realtek/phy_patch_rtl826x.c
+index 7bf10f0..24a87a1 100644
+--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
++++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
+@@ -117,6 +117,36 @@ static int rtl826x_phy_patch_sds_modify(struct phy_device *phydev, u32 sds_page,
+ 	return rtl826x_phy_patch_sds_set(phydev, sds_page, sds_reg, (ret & ~mask) | data);
+ }
+ 
++int rtl826x_phy_patch_rtk_serdes(struct phy_device *phydev)
++{
++	struct rtl826x_priv *priv = phydev->priv;
++	int ret;
++
++	if (!priv || !priv->patch_rtk_serdes)
++		return 0;
++
++	/* A value transition is intentional even when the final value already
++	 * matches. Keep 0x8003 active long enough for the Host AN state to
++	 * settle before restoring the tuned value. Do not reset the running
++	 * DTE XS.
++	 */
++	ret = rtl826x_phy_patch_sds_set(phydev, 0x07, 0x10, 0x8003);
++	if (ret < 0)
++		return ret;
++
++	usleep_range(10000, 12000);
++
++	ret = rtl826x_phy_patch_sds_set(phydev, 0x07, 0x10, 0x80aa);
++	if (ret < 0)
++		return ret;
++
++	ret = rtl826x_phy_patch_sds_set(phydev, 0x06, 0x12, 0x5078);
++	if (ret < 0)
++		return ret;
++
++	return 0;
++}
++
+ static int rtl826x_phy_patch_op(struct phy_device *phydev, const struct rtlgen_hwpatch *patch)
+ {
+ 	u32 mask = GENMASK(patch->msb, patch->lsb);
+diff --git a/drivers/net/phy/realtek/phy_patch_rtl826x.h b/drivers/net/phy/realtek/phy_patch_rtl826x.h
+index 4eac936..b6d5af8 100644
+--- a/drivers/net/phy/realtek/phy_patch_rtl826x.h
++++ b/drivers/net/phy/realtek/phy_patch_rtl826x.h
+@@ -11,5 +11,6 @@ int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page, u32 sds_r
+ 
+ int rtl8261n_phy_patch_db_init(struct phy_device *phydev);
+ int rtl8264b_phy_patch_db_init(struct phy_device *phydev);
++int rtl826x_phy_patch_rtk_serdes(struct phy_device *phydev);
+ 
+ #endif
+diff --git a/drivers/net/phy/realtek/realtek.h b/drivers/net/phy/realtek/realtek.h
+index 6ec56d7..616b46c 100644
+--- a/drivers/net/phy/realtek/realtek.h
++++ b/drivers/net/phy/realtek/realtek.h
+@@ -8,8 +8,18 @@
+ #include "phy_patch.h"
+ #include "phy_patch_rtl826x.h"
+ 
++enum rtl826x_rtk_serdes_state {
++	RTL826X_RTK_SERDES_IDLE,
++	RTL826X_RTK_SERDES_PULSE,
++	RTL826X_RTK_SERDES_RELEASE,
++	RTL826X_RTK_SERDES_CHECK_CARRIER,
++};
++
+ struct rtl826x_priv {
+ 	struct rtlgen_phy_patch_db *patch;
++	enum rtl826x_rtk_serdes_state rtk_serdes_state;
++	u32 rtk_serdes_pulse_count;
++	u8 rtk_serdes_carrier_polls;
+ 	bool enable_pma_low_power:1;
+ 	bool patch_rtk_serdes:1;
+ 	struct phy_device *phydev;
+diff --git a/drivers/net/phy/realtek/realtek_main.c b/drivers/net/phy/realtek/realtek_main.c
+index 0061215..65c8d29 100644
+--- a/drivers/net/phy/realtek/realtek_main.c
++++ b/drivers/net/phy/realtek/realtek_main.c
+@@ -23,6 +23,9 @@
+ 
+ #include "realtek.h"
+ 
++/* Let the HZ-driven PCS poll observe the new in-band word before retrying. */
++#define RTL826X_RTK_SERDES_CARRIER_GRACE_POLLS	120
++
+ #define RTL8201F_IER				0x13
+ 
+ #define RTL8201F_ISR				0x1e
+@@ -2615,6 +2618,8 @@ static int rtl826x_probe(struct phy_device *phydev)
+ 	priv->enable_pma_low_power = device_property_read_bool(dev, "realtek,enable-pma-low-power");
+ 	priv->patch_rtk_serdes =
+ 		device_property_read_bool(dev, "realtek,patch-rtk-serdes");
++	if (priv->patch_rtk_serdes)
++		priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
+ 	priv->phydev = phydev;
+ 	phydev->priv = priv;
+ 
+@@ -2805,11 +2810,17 @@ static int rtl825xb_get_features(struct phy_device *phydev)
+ 
+ static int rtl826x_config_aneg(struct phy_device *phydev)
+ {
++	struct rtl826x_priv *priv = phydev->priv;
+ 	bool changed = false;
+ 	u16 reg;
+ 	int ret;
+ 
+ 	phydev->mdix_ctrl = ETH_TP_MDI_AUTO;
++	if (priv && priv->patch_rtk_serdes) {
++		priv->rtk_serdes_state = RTL826X_RTK_SERDES_PULSE;
++		priv->rtk_serdes_pulse_count = 0;
++		priv->rtk_serdes_carrier_polls = 0;
++	}
+ 	if (phydev->autoneg == AUTONEG_DISABLE)
+ 		return genphy_c45_pma_setup_forced(phydev);
+ 
+@@ -2839,8 +2850,33 @@ static int rtl826x_config_aneg(struct phy_device *phydev)
+ 	return genphy_c45_check_and_restart_aneg(phydev, changed);
+ }
+ 
++static int rtl826x_rtk_serdes_pulse(struct phy_device *phydev)
++{
++	struct rtl826x_priv *priv = phydev->priv;
++	int ret;
++
++	ret = rtl826x_phy_patch_rtk_serdes(phydev);
++	if (ret < 0)
++		return ret;
++
++	priv->rtk_serdes_pulse_count++;
++	if (priv->rtk_serdes_pulse_count == 1)
++		phydev_info(phydev,
++			    "pulsed RTK SerDes flow_s 0x8003->0x80aa/0x5078 after copper AN\n");
++	else
++		phydev_dbg(phydev, "repeated RTK SerDes flow_s pulse %u\n",
++			   priv->rtk_serdes_pulse_count);
++
++	priv->rtk_serdes_state = RTL826X_RTK_SERDES_RELEASE;
++	priv->rtk_serdes_carrier_polls = 0;
++
++	return 0;
++}
++
+ static int rtl826x_read_status(struct phy_device *phydev)
+ {
++	struct rtl826x_priv *priv = phydev->priv;
++	bool aneg_done = phydev->autoneg == AUTONEG_DISABLE;
+ 	int status;
+ 	int ret;
+ 
+@@ -2871,7 +2907,96 @@ static int rtl826x_read_status(struct phy_device *phydev)
+ 			return ret;
+ 	}
+ 
+-	return genphy_c45_read_mdix(phydev);
++	ret = genphy_c45_read_mdix(phydev);
++	if (ret)
++		return ret;
++
++	if (!priv || !priv->patch_rtk_serdes)
++		return 0;
++
++	if (!aneg_done) {
++		ret = genphy_c45_aneg_done(phydev);
++		if (ret < 0)
++			return ret;
++		aneg_done = ret > 0;
++	}
++
++	phydev_dbg(phydev,
++		   "RTK status link=%u aneg_done=%u phy_state=%u rtk_state=%u attached=%s carrier=%d grace=%u\n",
++		   phydev->link, aneg_done, phydev->state,
++		   priv->rtk_serdes_state,
++		   phydev->attached_dev ? phydev->attached_dev->name : "<none>",
++		   phydev->attached_dev ? netif_carrier_ok(phydev->attached_dev) : -1,
++		   priv->rtk_serdes_carrier_polls);
++
++	if (!phydev->link) {
++		/* A flow_s pulse can make C45 report link down while AN restarts.
++		 * Keep the retry state across that interval. The initial pulse still
