# Source: openwrt/openwrt PR #22397（2026-08-17 手工对 master 重建——原 PR 对 master 5 文件冲突）
# Upstream: open（#22397）；合入即删
# Reason: XR1710G 板级通用编辑（uboot Makefile/envtools/platform.sh/02_network/an7581.mk）
# 注意：WAN=1G-1（02_network/dts 命名）按自用决策，与 PR 的 10G-wan 不同，见 FIXES F01
diff --git a/package/boot/uboot-airoha/Makefile b/package/boot/uboot-airoha/Makefile
index 5db35c0..2da4651 100644
--- a/package/boot/uboot-airoha/Makefile
+++ b/package/boot/uboot-airoha/Makefile
@@ -24,6 +24,13 @@ define U-Boot/an7581_gemtek_w1700k
   BUILD_SUBTARGET:=an7581
 endef
 
+define U-Boot/an7581_gemtek_xr1710g
+  NAME:=Gemtek XR1710G (UBI)
+  UBOOT_CONFIG:=an7581_xr1710g
+  BUILD_DEVICES:=gemtek_xr1710g-ubi
+  BUILD_SUBTARGET:=an7581
+endef
+
 define U-Boot/an7581_nokia_valyrian
   NAME:=Nokia Valyrian
   UBOOT_CONFIG:=an7581_nokia_valyrian
@@ -83,6 +90,7 @@ endef
 
 UBOOT_TARGETS := \
 	an7581_gemtek_w1700k \
+	an7581_gemtek_xr1710g \
 	an7581_nokia_valyrian \
 	an7581_nokia_xg-040g-md \
 	an7581_rfb \
diff --git a/package/boot/uboot-tools/uboot-envtools/files/airoha_an7581 b/package/boot/uboot-tools/uboot-envtools/files/airoha_an7581
index c0a5c9f..fb850a4 100644
--- a/package/boot/uboot-tools/uboot-envtools/files/airoha_an7581
+++ b/package/boot/uboot-tools/uboot-envtools/files/airoha_an7581
@@ -11,7 +11,35 @@
 
 board=$(board_name)
 
+ubootenv_add_ubi_xr1710g() {
+	. /lib/upgrade/nand.sh
+	local envubi="$(nand_find_ubi ubi)"
+	local dev="/dev/$(nand_find_volume "$envubi" ubootenv)"
+	local dev2="/dev/$(nand_find_volume "$envubi" ubootenv2)"
+
+	# YYH2913/http-uboot-xr1710g uses CONFIG_ENV_SIZE=0x4000. The generic
+	# 0x1f000 layout writes a CRC U-Boot does not accept (F66 root cause).
+	ubootenv_add_uci_config "$dev" "0x0" "0x4000" "0x1f000" "1"
+	ubootenv_add_uci_config "$dev2" "0x0" "0x4000" "0x1f000" "1"
+}
+
 case "$board" in
+gemtek,xr1710g-ubi)
+	# Preserved config from an older image may point at the correct dynamic UBI
+	# volumes while still using the incompatible generic 0x1f000 size. Keep only
+	# the exact redundant 0x4000 layout expected by YYH2913 U-Boot.
+	# NOTE: /etc/config/ubootenv always exists here (touched above), so the real
+	# discriminator is /etc/fw_env.config.
+	if [ -e /etc/fw_env.config ] &&
+		[ "$(grep -Ec '^/dev/ubi[0-9]+_[0-9]+[[:space:]]+0x0[[:space:]]+0x4000[[:space:]]+0x1f000[[:space:]]+1$' /etc/fw_env.config)" -eq 2 ]; then
+		ubootenv_add_app_config || true
+		exit 0
+	fi
+
+	rm -f /etc/config/ubootenv /etc/fw_env.config /etc/fw_sys.config
+	touch /etc/config/ubootenv
+	ubootenv_add_ubi_xr1710g
+	;;
 gemtek,w1700k-ubi|\
 nokia,xg-040g-md-ubi)
 	ubootenv_add_ubi_default

diff --git a/target/linux/airoha/an7581/base-files/etc/board.d/02_network b/target/linux/airoha/an7581/base-files/etc/board.d/02_network
