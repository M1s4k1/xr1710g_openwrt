++	CRYPTO_FALLBACK_GROUP("raw_3des", CRYPTO_FALLBACK_SKCIPHER,
++			      "cbc(des3_ede)", "cbc(des3_ede-eip93)",
++			      eip93_fallback_3des_key, eip93_fallback_raw_3des,
++			      ARRAY_SIZE(eip93_fallback_raw_3des)),
