++static const char *
++crypto_fallback_alg_name(const struct crypto_fallback_benchmark *alg,
++			 enum crypto_fallback_implementation implementation)
++{
++	if (implementation == CRYPTO_FALLBACK_HARDWARE)
++		return alg->driver_name;
++
++	return alg->name;
++}
