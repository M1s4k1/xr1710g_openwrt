++	"cbc(aes-eip93)",
++	"ctr(aes-eip93)",
++	"rfc3686(ctr(aes-eip93))",
++};
++
++static const char *const eip93_fallback_raw_des[] = {
++	"ecb(des-eip93)",
++	"cbc(des-eip93)",
++};
++
++static const char *const eip93_fallback_raw_3des[] = {
