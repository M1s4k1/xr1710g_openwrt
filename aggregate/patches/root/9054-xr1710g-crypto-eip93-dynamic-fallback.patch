+@@ -485,6 +495,7 @@ static void eip93_crypto_remove(struct platform_device *pdev)
+ 
+ 	algo_flags = readl(eip93->base + EIP93_REG_PE_OPTION_1);
+ 
++	eip93_fallback_unregister();
+ 	eip93_unregister_algs(algo_flags, ARRAY_SIZE(eip93_algs));
+ 	eip93_cleanup(eip93);
