diff --git a/target/linux/airoha/patches-6.18/9999-crypto-eip93-dynamic-fallback.patch b/target/linux/airoha/patches-6.18/9999-crypto-eip93-dynamic-fallback.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-crypto-eip93-dynamic-fallback.patch
@@ -0,0 +1,2921 @@
+# Source: hurryman2212/OpenW1700k-test @offload-oc（2026-09-12 P2 吸收，父代理独立复核）
+# Upstream: n/a（作者自持）
+# Reason: EIP93 **动态软件回退**——crypto 层引入 fallback 框架，EIP93 能加速的走硬件、不能的
+#   （如 GCM/rfc4106）透明回退软件，而不是整包拒绝/失败。这正面解开本仓 **F52（issue #6）** 的
+#   死结：F52 的原结论是"EIP93 未注册 GCM-AEAD，故 ESP 主用 AEAD 落不到硬件，先验证后供给"。
+#   含：crypto cycle benchmark 助手移出 tcrypt、动态软回退框架、EIP93 接入、禁用期消除 proxy 开销、
+#   以及上游 EIP93 ecb-des typo 修正（backport-6.18）。
+# 实证：对本仓 kernel 6.18.44 真源**全序 5/5 干净应用**（offset 最大 42），并正确新增
+#   `drivers/crypto/inside-secure/eip93/eip93-fallback.{c,h}` 且接入 Makefile。
+# 档位 #EXP：改内核 crypto 核心 + EIP93 驱动，必须构建 + 实机验证。
+# 判据：① 构建通过；② 对照 `authenc(hmac(sha256),cbc(aes))`（应走硬件）与 `rfc4106(gcm(aes))`
+#   （应软回退）；`grep eip93 /proc/crypto` 出现在实际使用的算法链上 + EIP93 统计增长。
+# 依赖：EIP93 驱动已由 vendor/fanboy/02 提供（#EXP）；A 系列（xfrm 框架）为其上层。
+From e0ce93088c1d9772e928fcbd113a446b7fb7442f Mon Sep 17 00:00:00 2001
+Message-ID: <e0ce93088c1d9772e928fcbd113a446b7fb7442f.1785226804.git.hurryman2212@gmail.com>
+In-Reply-To: <cover.1785226804.git.hurryman2212@gmail.com>
+References: <cover.1785226804.git.hurryman2212@gmail.com>
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 28 Jul 2026 11:51:55 +0900
+Subject: [PATCH 1/4] crypto: move cycle benchmark helpers out of tcrypt
+To: Herbert Xu <herbert@gondor.apana.org.au>,
+ Christian Marangi <ansuelsmth@gmail.com>,
+ linux-crypto@vger.kernel.org
+Cc: "David S. Miller" <davem@davemloft.net>,
+ Antoine Tenart <atenart@kernel.org>,
+ linux-kernel@vger.kernel.org
+
+Move the reusable AEAD, ahash, and skcipher cycle measurement loops
+into a dedicated benchmark module. Preserve tcrypt's existing output
+and benchmark behavior while allowing crypto drivers to use the same
+helpers for runtime comparisons.
+
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ crypto/Kconfig             |  15 ++-
+ crypto/Makefile            |   2 +
+ crypto/benchmark.c         | 180 +++++++++++++++++++++++++++++++
+ crypto/tcrypt.c            | 213 +++++--------------------------------
+ include/crypto/benchmark.h |  24 +++++
+ 5 files changed, 242 insertions(+), 192 deletions(-)
+ create mode 100644 crypto/benchmark.c
+ create mode 100644 include/crypto/benchmark.h
+
+diff --git a/crypto/Kconfig b/crypto/Kconfig
+index f1e372195273..0cba261e3b88 100644
+--- a/crypto/Kconfig
++++ b/crypto/Kconfig
+@@ -257,9 +257,22 @@ config CRYPTO_KRB5ENC
+ 	  profile.  This is required for Kerberos 5-style encryption, used by
+ 	  sunrpc/NFS and rxrpc/AFS.
+ 
+-config CRYPTO_BENCHMARK
+-	tristate "Crypto benchmarking module"
+-	depends on m || EXPERT
++config CRYPTO_BENCHMARK_LIB
++	tristate
++	select CRYPTO_AEAD
++	select CRYPTO_HASH
++	select CRYPTO_MANAGER
++	select CRYPTO_SKCIPHER
++	help
++	  Build reusable benchmark helpers for Crypto API algorithms.  This
++	  internal library is shared by tcrypt and drivers that select
++	  implementations from measurements made while their devices are
++	  initialized.
++
++config CRYPTO_BENCHMARK
++	tristate "Crypto benchmarking module"
++	depends on m || EXPERT
++	select CRYPTO_BENCHMARK_LIB
+ 	select CRYPTO_MANAGER
+ 	help
+ 	  Quick & dirty crypto benchmarking module.
+ 
+diff --git a/crypto/Makefile b/crypto/Makefile
+index 8386d55a9755..77720b746503 100644
+--- a/crypto/Makefile
++++ b/crypto/Makefile
+@@ -172,6 +172,8 @@ UBSAN_SANITIZE_jitterentropy.o = n
+ jitterentropy_rng-y := jitterentropy.o jitterentropy-kcapi.o
+ obj-$(CONFIG_CRYPTO_JITTERENTROPY_TESTINTERFACE) += jitterentropy-testing.o
+ obj-$(CONFIG_CRYPTO_BENCHMARK) += tcrypt.o
++obj-$(CONFIG_CRYPTO_BENCHMARK_LIB) += crypt-benchmark.o
++crypt-benchmark-y := benchmark.o
+ obj-$(CONFIG_CRYPTO_GHASH) += ghash-generic.o
+ obj-$(CONFIG_CRYPTO_POLYVAL) += polyval-generic.o
+ obj-$(CONFIG_CRYPTO_USER_API) += af_alg.o
+diff --git a/crypto/benchmark.c b/crypto/benchmark.c
+new file mode 100644
+index 000000000000..ad27cdaa7491
+--- /dev/null
++++ b/crypto/benchmark.c
+@@ -0,0 +1,180 @@
++// SPDX-License-Identifier: GPL-2.0
++
++#include <crypto/aead.h>
++#include <crypto/benchmark.h>
++#include <crypto/hash.h>
++#include <crypto/skcipher.h>
++#include <linux/module.h>
++#include <linux/timex.h>
++
++int crypto_benchmark_aead_cycles(struct aead_request *req, bool encrypt,
++				 unsigned int warmup_runs, unsigned int runs,
++				 u64 *total_cycles)
++{
++	struct crypto_wait *wait;
++	unsigned int i;
++	u64 cycles = 0;
++	int ret;
++
++	if (!req || !req->base.data || !runs || !total_cycles)
++		return -EINVAL;
++
++	wait = req->base.data;
++	*total_cycles = 0;
++
++	for (i = 0; i < warmup_runs; i++) {
++		if (encrypt)
++			ret = crypto_wait_req(crypto_aead_encrypt(req), wait);
++		else
++			ret = crypto_wait_req(crypto_aead_decrypt(req), wait);
++		if (ret)
++			return ret;
++	}
++
++	for (i = 0; i < runs; i++) {
++		cycles_t start, end;
++
++		start = get_cycles();
++		if (encrypt)
++			ret = crypto_wait_req(crypto_aead_encrypt(req), wait);
++		else
++			ret = crypto_wait_req(crypto_aead_decrypt(req), wait);
++		end = get_cycles();
++		if (ret)
++			return ret;
++
++		cycles += end - start;
++	}
++
++	*total_cycles = cycles;
++
++	return 0;
++}
++EXPORT_SYMBOL_GPL(crypto_benchmark_aead_cycles);
++
++int crypto_benchmark_ahash_cycles(struct ahash_request *req,
++				  unsigned int block_size,
++				  unsigned int update_size,
++				  unsigned int warmup_runs, unsigned int runs,
++				  u64 *total_cycles)
++{
++	struct crypto_wait *wait;
++	unsigned int processed;
++	unsigned int i;
++	u64 cycles = 0;
++	int ret;
++
++	if (!req || !req->base.data || !block_size || !update_size ||
++	    block_size % update_size || !runs || !total_cycles)
++		return -EINVAL;
++
++	wait = req->base.data;
++	*total_cycles = 0;
++
++	for (i = 0; i < warmup_runs; i++) {
++		if (update_size == block_size) {
++			ret = crypto_wait_req(crypto_ahash_digest(req), wait);
++			if (ret)
++				return ret;
++			continue;
++		}
++
++		ret = crypto_wait_req(crypto_ahash_init(req), wait);
++		if (ret)
++			return ret;
++		for (processed = 0; processed < block_size;
++		     processed += update_size) {
++			ret = crypto_wait_req(crypto_ahash_update(req), wait);
++			if (ret)
++				return ret;
++		}
++		ret = crypto_wait_req(crypto_ahash_final(req), wait);
++		if (ret)
++			return ret;
++	}
++
++	for (i = 0; i < runs; i++) {
++		cycles_t start, end;
++
++		start = get_cycles();
++		if (update_size == block_size) {
++			ret = crypto_wait_req(crypto_ahash_digest(req), wait);
++		} else {
++			ret = crypto_wait_req(crypto_ahash_init(req), wait);
++			if (ret)
++				goto measure_end;
++			for (processed = 0; processed < block_size;
++			     processed += update_size) {
++				ret = crypto_wait_req(crypto_ahash_update(req),
++						      wait);
++				if (ret)
++					goto measure_end;
++			}
++			ret = crypto_wait_req(crypto_ahash_final(req), wait);
++		}
++measure_end:
++		end = get_cycles();
++		if (ret)
++			return ret;
++
++		cycles += end - start;
++	}
++
++	*total_cycles = cycles;
++
++	return 0;
++}
++EXPORT_SYMBOL_GPL(crypto_benchmark_ahash_cycles);
++
++int crypto_benchmark_skcipher_cycles(struct skcipher_request *req, bool encrypt,
++				     unsigned int warmup_runs,
++				     unsigned int runs, u64 *total_cycles)
++{
++	struct crypto_wait *wait;
++	unsigned int i;
++	u64 cycles = 0;
++	int ret;
++
++	if (!req || !req->base.data || !runs || !total_cycles)
++		return -EINVAL;
++
++	wait = req->base.data;
++	*total_cycles = 0;
++
++	for (i = 0; i < warmup_runs; i++) {
++		if (encrypt)
++			ret = crypto_wait_req(crypto_skcipher_encrypt(req),
++					      wait);
++		else
++			ret = crypto_wait_req(crypto_skcipher_decrypt(req),
++					      wait);
++		if (ret)
++			return ret;
++	}
++
++	for (i = 0; i < runs; i++) {
++		cycles_t start, end;
++
++		start = get_cycles();
++		if (encrypt)
++			ret = crypto_wait_req(crypto_skcipher_encrypt(req),
++					      wait);
++		else
++			ret = crypto_wait_req(crypto_skcipher_decrypt(req),
++					      wait);
++		end = get_cycles();
++		if (ret)
++			return ret;
++
++		cycles += end - start;
++	}
++
++	*total_cycles = cycles;
++
++	return 0;
++}
++EXPORT_SYMBOL_GPL(crypto_benchmark_skcipher_cycles);
++
++MODULE_AUTHOR("Jihong Min <hurryman2212@gmail.com>");
++MODULE_DESCRIPTION("Crypto API benchmark helpers");
++MODULE_LICENSE("GPL");
+diff --git a/crypto/tcrypt.c b/crypto/tcrypt.c
+index 61a2501bfe9b..81c77f3d7a17 100644
+--- a/crypto/tcrypt.c
++++ b/crypto/tcrypt.c
+@@ -20,6 +20,7 @@
+ #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+ 
