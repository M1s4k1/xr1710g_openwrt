++{
++	eip93_fallback =
++		crypto_fallback_register(THIS_MODULE, eip93->dev,
++					 eip93_fallback_groups,
++					 ARRAY_SIZE(eip93_fallback_groups));
++
++	return PTR_ERR_OR_ZERO(eip93_fallback);
++}
++
++void eip93_fallback_unregister(void)
++{
