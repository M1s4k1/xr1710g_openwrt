@@ -327,7 +327,7 @@ Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
  };
  
  struct airoha_gdm_port {
-@@ -561,8 +564,8 @@ struct airoha_gdm_port {
+@@ -562,8 +565,8 @@ struct airoha_gdm_port {
