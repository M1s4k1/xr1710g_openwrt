@@ -0,0 +1,93 @@
+# Source: YYH2913/openwrt target/linux/airoha/patches-6.18/925-net-airoha-npu-close-recovery-synchronization-race.patch
+#   （Yanghan Ye, 2026-08-07, 203581db）—— 2026-09-12 P3-A 吸收，#EXP
+# Upstream: n/a（作者自持）
+# Reason: recovery flag 只在 core 0 锁下更新，而检查发生在“所选 mailbox core”锁下——多 mailbox
+#   core 启用后成为数据竞争。改用 atomic_t recovering；置位后 acquire/release **每个** core 锁
+#   以排空已通过检查的请求；新请求在 restart+状态更新完成前一律 -EAGAIN。
+# 实证：923 → 924-fix → 本项 对 6.18.44 真源 fuzz=0。
+diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
+index e017738..7c7979c 100644
+--- a/drivers/net/ethernet/airoha/airoha_npu.c
++++ b/drivers/net/ethernet/airoha/airoha_npu.c
+@@ -189,7 +189,7 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
+ 	 * foe_commit under atomic context).
+ 	 */
+ 	spin_lock_bh(&core->lock);
+-	if (npu->recovering) {
++	if (atomic_read(&npu->recovering)) {
+ 		ret = -EAGAIN;
+ 		goto unlock;
+ 	}
+@@ -331,24 +331,26 @@ static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
+ 		return -EINVAL;
+ 
+ 	mutex_lock(&npu->recovery_lock);
++	atomic_set(&npu->recovering, 1);
++
++	/* Drain mailbox requests which passed the recovery check. */
++	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
++		spin_lock_bh(&npu->cores[i].lock);
++		spin_unlock_bh(&npu->cores[i].lock);
++	}
+ 
+-	spin_lock_bh(&npu->cores[0].lock);
+-	npu->recovering = true;
+ 	err = regmap_read(npu->regmap, REG_CR_BOOT_CONFIG, &val);
+-	spin_unlock_bh(&npu->cores[0].lock);
+ 	if (err)
+ 		goto out;
+ 
+ 	val = (val & GENMASK(7, 0)) | BIT(8 + core);
+ 	for (i = 0; i < 2; i++) {
+-		spin_lock_bh(&npu->cores[0].lock);
+ 		err = regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, val);
+ 		if (!err && !core)
+ 			err = regmap_write(npu->regmap, REG_CR_NPU_MIB(0),
+ 					   U32_MAX);
+ 		if (!err)
+ 			err = regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 2);
+-		spin_unlock_bh(&npu->cores[0].lock);
+ 		if (err)
+ 			break;
+ 
+@@ -356,10 +358,8 @@ static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
+ 	}
+ 
+ out:
+-	spin_lock_bh(&npu->cores[0].lock);
+ 	npu->recovery_err = err;
+-	npu->recovering = false;
+-	spin_unlock_bh(&npu->cores[0].lock);
++	atomic_set(&npu->recovering, 0);
+ 	mutex_unlock(&npu->recovery_lock);
+ 
+ 	return err;
+@@ -812,6 +812,7 @@ static int airoha_npu_probe(struct platform_device *pdev)
+ 
+ 	npu->dev = dev;
+ 	mutex_init(&npu->recovery_lock);
++	atomic_set(&npu->recovering, 0);
+ 	npu->ops.ppe_init = airoha_npu_ppe_init;
+ 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
+ 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
+diff --git a/include/linux/soc/airoha/airoha_offload.h b/include/linux/soc/airoha/airoha_offload.h
+index ab2aee1..afc6402 100644
+--- a/include/linux/soc/airoha/airoha_offload.h
++++ b/include/linux/soc/airoha/airoha_offload.h
+@@ -6,6 +6,7 @@
+ #ifndef AIROHA_OFFLOAD_H
+ #define AIROHA_OFFLOAD_H
+ 
++#include <linux/atomic.h>
+ #include <linux/mutex.h>
+ #include <linux/skbuff.h>
+ #include <linux/spinlock.h>
+@@ -170,7 +171,7 @@ struct airoha_npu {
+ 	struct regmap *regmap;
+ 	/* serialize NPU core recovery */
+ 	struct mutex recovery_lock;
+-	bool recovering;
++	atomic_t recovering;
+ 	int recovery_err;
+ 
+ 	struct airoha_npu_core {
diff --git a/target/linux/airoha/patches-6.18/9999-33-net-airoha-fix-offload-provider-device-link-lifetime.patch b/target/linux/airoha/patches-6.18/9999-33-net-airoha-fix-offload-provider-device-link-lifetime.patch
