++static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
++{
++	int i, err = 0;
++	u32 val;
++
++	if (core < 0 || core >= ARRAY_SIZE(npu->cores))
++		return -EINVAL;
++
++	mutex_lock(&npu->recovery_lock);
++
++	spin_lock_bh(&npu->cores[0].lock);
