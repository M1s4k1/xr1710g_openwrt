diff --git a/target/linux/airoha/patches-6.18/9999-net-airoha-soe-17-flow-offload-xfrm-actions.patch b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-17-flow-offload-xfrm-actions.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9999-net-airoha-soe-17-flow-offload-xfrm-actions.patch
@@ -0,0 +1,50 @@
+# Source: hurryman2212/OpenW1700k-test @offload-oc 9999-17（2026-09-12 P2 SOE 主体吸收，按本仓真源重基）
+# 完整说明（依赖链/重基依据/判据）见 patches/MANIFEST 与 research-20260912/inner/soe-head.txt
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Jihong Min <hurryman2212@gmail.com>
+Date: Tue, 4 Aug 2026 16:29:39 +0900
+Subject: [PATCH] flow_offload: add XFRM action metadata
+
+Carry XFRM state and direction through hardware flow actions.
+
+Assisted-by: Codex:gpt-5.6
+Signed-off-by: Jihong Min <hurryman2212@gmail.com>
+---
+ include/net/flow_offload.h | 10 ++++++++++
+ 1 file changed, 10 insertions(+)
+
+diff --git a/include/net/flow_offload.h b/include/net/flow_offload.h
+index 596ab97..19c184e 100644
+--- a/include/net/flow_offload.h
++++ b/include/net/flow_offload.h
+@@ -6,6 +6,8 @@
+ #include <linux/netlink.h>
+ #include <net/flow_dissector.h>
+ 
++struct xfrm_state;
++
+ struct flow_match {
+ 	struct flow_dissector	*dissector;
+ 	void			*mask;
+@@ -184,6 +186,7 @@ enum flow_action_id {
+ 	FLOW_ACTION_VLAN_PUSH_ETH,
+ 	FLOW_ACTION_VLAN_POP_ETH,
+ 	FLOW_ACTION_CONTINUE,
++	FLOW_ACTION_XFRM,
+ 	NUM_FLOW_ACTIONS,
+ };
+ 
+@@ -327,6 +330,13 @@ struct flow_action_entry {
+ 		struct {				/* FLOW_ACTION_PPPOE_PUSH */
+ 			u16		sid;
+ 		} pppoe;
++		struct {				/* FLOW_ACTION_XFRM */
++			struct xfrm_state *state;
++			u32		flow_id;
++			u32		policy_genid;
++			u8		dir;
++			bool		flow_id_valid;
++		} xfrm;
+ 	};
+ 	struct flow_action_cookie *user_cookie; /* user defined action cookie */
+ };
