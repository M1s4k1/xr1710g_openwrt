# Source: YYH2913/openwrt mt76/0153（Yanghan Ye, 2026-08-07）—— 2026-09-12 P3-B 吸收，#EXP
# Upstream: n/a
# Reason: NPU RX IRQ 是 device-managed 但绑定在 Wi-Fi PCI 设备上，remove 之后仍注册着，
#   而 DMA 清理已删掉对应 NAPI/page pool → in-flight NAPI completion 会重新使能中断线
#   （remove/reload 路径的 UAF/中断风暴）。修法：struct mt76_queue 加 npu_irq/npu_irq_registered；
#   新增 mt76_npu_rx_queues_deinit()（持 dev->mutex 先 ack+disable NPU 侧 IRQ，释放锁后
#   devm_free_irq + napi_synchronize，再二次 mask）；mt7996_unregister_device() 在
#   mt76_unregister_device() 之后调用 stop + deinit；pci probe unwind 也调用；
#   mt76_npu_deinit() 改为 rcu_replace_pointer → mutex_unlock → synchronize_rcu →
#   queue cleanup → dev->dma_dev = dev->dev → 再 airoha_npu_put()/airoha_ppe_put_dev()。
# 与 0156/0161 同批（0156 完成 teardown，0161 用 dev->napi_registered bitmap 取代中间态）。
# 实证：对 be5ce791 + 本仓 mt76 内层全序按序 fuzz=0。
diff --git a/mt76.h b/mt76.h
index c57c6173..f7c6e07c 100644
--- a/mt76.h
+++ b/mt76.h
@@ -257,8 +257,10 @@ struct mt76_queue {
 	int ndesc;
 	int queued;
 	int buf_size;
+	int npu_irq;
 	bool stopped;
 	bool blocked;
+	bool npu_irq_registered;
 
 	u8 buf_offset;
 	u16 flags;
@@ -1677,6 +1679,7 @@ int mt76_npu_dma_add_buf(struct mt76_phy *phy, struct mt76_queue *q,
 			 struct sk_buff *skb, struct mt76_queue_buf *buf,
 			 void *txwi_ptr);
 int mt76_npu_rx_queue_init(struct mt76_dev *dev, struct mt76_queue *q);
+void mt76_npu_rx_queues_deinit(struct mt76_dev *dev);
 int mt76_npu_fill_rx_queue(struct mt76_dev *dev, struct mt76_queue *q);
 void mt76_npu_queue_cleanup(struct mt76_dev *dev, struct mt76_queue *q);
 void mt76_npu_disable_irqs(struct mt76_dev *dev);
@@ -1712,6 +1715,10 @@ static inline int mt76_npu_fill_rx_queue(struct mt76_dev *dev,
 	return 0;
 }
 
+static inline void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
+{
+}
+
 static inline void mt76_npu_queue_cleanup(struct mt76_dev *dev,
 					  struct mt76_queue *q)
 {
diff --git a/mt7996/init.c b/mt7996/init.c
index ca1c1017..bb486a56 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1839,6 +1839,8 @@ error:
 
 void mt7996_unregister_device(struct mt7996_dev *dev)
 {
+	int err;
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->wed_rro.work);
 	cancel_work_sync(&dev->reset_work);
@@ -1848,6 +1850,10 @@ void mt7996_unregister_device(struct mt7996_dev *dev)
 	mt7996_unregister_thermal(&dev->phy);
 	mt7996_coredump_unregister(dev);
 	mt76_unregister_device(&dev->mt76);
+	err = mt7996_npu_hw_stop(dev);
+	if (err)
+		dev_warn(dev->mt76.dev, "failed to stop NPU: %d\n", err);
+	mt76_npu_rx_queues_deinit(&dev->mt76);
 	mt7996_wed_rro_free(dev);
 	mt7996_mcu_exit(dev);
 	mt7996_tx_token_put(dev);
diff --git a/mt7996/mmio.c b/mt7996/mmio.c
index 8b4815e5..50b48180 100644
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -723,6 +723,9 @@ static void mt7996_rx_poll_complete(struct mt76_dev *mdev,
 	if (q == MT_RXQ_NPU0 || q == MT_RXQ_NPU1) {
 		struct airoha_npu *npu;
 
+		if (!READ_ONCE(mdev->q_rx[q].npu_irq_registered))
+			return;
+
 		npu = rcu_dereference(mdev->mmio.npu);
 		if (npu)
 			airoha_npu_wlan_enable_irq(npu, q - MT_RXQ_NPU0);
diff --git a/mt7996/pci.c b/mt7996/pci.c
index b7d9193e..cf4f7858 100644
--- a/mt7996/pci.c
+++ b/mt7996/pci.c
@@ -102,7 +102,7 @@ static int mt7996_pci_probe(struct pci_dev *pdev,
 	struct pci_dev *hif2_dev;
 	struct mt7996_hif *hif2;
 	struct mt7996_dev *dev;
-	int irq, hif2_irq, ret;
+	int irq, hif2_irq, ret, npu_ret;
 	struct mt76_dev *mdev;
 
 	ret = pcim_enable_device(pdev);
@@ -199,6 +199,10 @@ static int mt7996_pci_probe(struct pci_dev *pdev,
 	return 0;
 
 free_hif2_irq:
+	npu_ret = mt7996_npu_hw_stop(dev);
+	if (npu_ret)
+		dev_warn(mdev->dev, "failed to stop NPU: %d\n", npu_ret);
+	mt76_npu_rx_queues_deinit(mdev);
 	if (dev->hif2)
 		devm_free_irq(mdev->dev, hif2_irq, dev);
 free_hif2_wed_irq_vector:
diff --git a/npu.c b/npu.c
index 4debf5e2..6677ed69 100644
--- a/npu.c
+++ b/npu.c
@@ -314,17 +314,30 @@ int mt76_npu_rx_queue_init(struct mt76_dev *dev, struct mt76_queue *q)
 	name = devm_kasprintf(dev->dev, GFP_KERNEL, "mt76-npu.%d", index);
 	if (!name) {
 		err = -ENOMEM;
-		goto out;
+		goto error_queue;
 	}
 
-	err = devm_request_irq(dev->dev, irq, mt76_npu_irq_handler,
-			       IRQF_SHARED, name, q);
-	if (err)
-		goto out;
-
 	netif_napi_add(dev->napi_dev, &dev->napi[qid], mt76_npu_rx_poll);
 	mt76_npu_fill_rx_queue(dev, q);
 	napi_enable(&dev->napi[qid]);
+
+	err = devm_request_irq(dev->dev, irq, mt76_npu_irq_handler,
+			       IRQF_SHARED, name, q);
+	if (err) {
+		napi_disable(&dev->napi[qid]);
+		netif_napi_del(&dev->napi[qid]);
+		goto error_queue;
+	}
+
+	q->npu_irq = irq;
+	WRITE_ONCE(q->npu_irq_registered, true);
+	goto out;
+
+error_queue:
+	mt76_npu_queue_cleanup(dev, q);
+	page_pool_destroy(q->page_pool);
+	q->page_pool = NULL;
+	q->ndesc = 0;
 out:
 	mutex_unlock(&dev->mutex);
 
@@ -332,6 +345,69 @@ out:
 }
 EXPORT_SYMBOL_GPL(mt76_npu_rx_queue_init);
 
+void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
+{
+	bool registered[2] = {};
+	int irqs[2] = {};
+	struct airoha_npu *npu;
+	int i;
+
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+
+	for (i = 0; i < ARRAY_SIZE(registered); i++) {
+		struct mt76_queue *q = &dev->q_rx[MT_RXQ_NPU0 + i];
+		u32 status;
+
+		if (!READ_ONCE(q->npu_irq_registered))
+			continue;
+
+		registered[i] = true;
+		irqs[i] = q->npu_irq;
+		WRITE_ONCE(q->npu_irq_registered, false);
+
+		if (!npu)
+			continue;
+
+		status = airoha_npu_wlan_get_irq_status(npu, i);
+		airoha_npu_wlan_set_irq_status(npu, status);
+		airoha_npu_wlan_disable_irq(npu, i);
+	}
+	mutex_unlock(&dev->mutex);
+
+	for (i = 0; i < ARRAY_SIZE(registered); i++) {
+		struct mt76_queue *q = &dev->q_rx[MT_RXQ_NPU0 + i];
+
+		if (!registered[i])
+			continue;
+
+		devm_free_irq(dev->dev, irqs[i], q);
+		napi_synchronize(&dev->napi[MT_RXQ_NPU0 + i]);
+	}
+
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+	for (i = 0; i < ARRAY_SIZE(registered); i++) {
+		struct mt76_queue *q = &dev->q_rx[MT_RXQ_NPU0 + i];
+		u32 status;
+
+		if (!registered[i])
+			continue;
+
+		q->npu_irq = -1;
+		if (!npu)
+			continue;
+
+		status = airoha_npu_wlan_get_irq_status(npu, i);
+		airoha_npu_wlan_set_irq_status(npu, status);
+		airoha_npu_wlan_disable_irq(npu, i);
+	}
+	mutex_unlock(&dev->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_npu_rx_queues_deinit);
+
 static int mt76_npu_setup_tc_block_cb(enum tc_setup_type type,
 				      void *type_data, void *cb_priv)
 {
@@ -566,16 +642,17 @@ void mt76_npu_deinit(struct mt76_dev *dev)
 
 	npu = rcu_replace_pointer(dev->mmio.npu, NULL,
 				  lockdep_is_held(&dev->mutex));
-	if (npu)
-		airoha_npu_put(npu);
-
 	ppe_dev = rcu_replace_pointer(dev->mmio.ppe_dev, NULL,
 				      lockdep_is_held(&dev->mutex));
-	if (ppe_dev)
-		airoha_ppe_put_dev(ppe_dev);
-
 	mutex_unlock(&dev->mutex);
+	synchronize_rcu();
 
 	mt76_npu_queue_cleanup(dev, &dev->q_rx[MT_RXQ_NPU0]);
 	mt76_npu_queue_cleanup(dev, &dev->q_rx[MT_RXQ_NPU1]);
+	dev->dma_dev = dev->dev;
+
+	if (npu)
+		airoha_npu_put(npu);
+	if (ppe_dev)
+		airoha_ppe_put_dev(ppe_dev);
 }
