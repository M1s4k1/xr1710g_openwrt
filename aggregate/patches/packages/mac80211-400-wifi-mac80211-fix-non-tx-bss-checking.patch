# Source: YYH2913/openwrt@xr1710g-6.18-integration package/kernel/mac80211/patches/subsys/400-mtk-mac80211-fix-non-TX-BSS-checking-in-ieee802_11_p.patch
# Upstream: n/a（MTK 内部树）—— 2026-09-12 P3-D 吸收，#EXP
# Reason: ieee802_11_parse_elems_full() 的 non-TX BSS 判定错（1 行）
# 实证：裁剪后的 backports-7.2（上游 subsys 20 补丁 + 本仓 411）之上应用（410 已按 7.2 重基为 fuzz=0）。
From 19cf1bbd3c1d207f89e9e6bcdb770406b1b3153f Mon Sep 17 00:00:00 2001
From: Shayne Chen <shayne.chen@mediatek.com>
Date: Wed, 16 Apr 2025 16:47:12 +0800
Subject: [PATCH 091/137] mtk: mac80211: fix non-TX BSS checking in
 ieee802_11_parse_elems_full()

Signed-off-by: Shayne Chen <shayne.chen@mediatek.com>
---
 net/mac80211/parse.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/net/mac80211/parse.c b/net/mac80211/parse.c
index 8260f6bd..59451764 100644
--- a/net/mac80211/parse.c
+++ b/net/mac80211/parse.c
@@ -1072,7 +1072,7 @@ ieee802_11_parse_elems_full(struct ieee80211_elems_parse_params *params)
 	 * In any case, we only look for one at a time, as encoded by
 	 * the WARN_ON above.
 	 */
-	if (params->bss) {
+	if (params->bss && params->bss->transmitted_bss) {
 		int nontx_len =
 			ieee802_11_find_bssid_profile(params->start,
 						      params->len,
-- 
