From 5b917d4b0b6378a615dc8501837e138ce4bfec74 Mon Sep 17 00:00:00 2001
From: Tao <gongtao0607@gmail.com>
Date: Sun, 16 Aug 2026 06:01:01 +0000
Subject: [PATCH] mt76: mt7996: release HW_RRO session on BlockAck teardown

Apple macOS/iOS stations negotiate RX BlockAck (A-MPDU) sessions with
sub-64 frame windows on latency-sensitive TIDs (e.g. TID 6 buf_size=8,
TID 1 buf_size=16) in addition to standard bulk queues (TID 0 with
buf_size=64/256).  Enabling HW_RRO on these sub-64 window sessions
leaves the MT7996 on-chip reordering ring and its SRAM session lookup
state machine in an invalid state, and -- because the NPU firmware never
releases the session on its own -- the stale per-wcid flow context is
inherited by the next association that reuses the same wcid, permanently
stalling uplink RX offload (FOE_ID=0 storm) until a reboot.

The previous mitigation disabled HW_RRO entirely for sub-64 window
sessions, which works around the trigger but sacrifices hardware
reordering offload on exactly the latency-sensitive queues that would
benefit from it, and does nothing about already-poisoned firmware state.

This patch takes the complementary approach: keep HW_RRO enabled, and
explicitly release the firmware-side session on BlockAck teardown via
the UNI_RRO_DEL_BA_SESSION MCU command.  The session id is reported
asynchronously by the firmware in the UNI_WED_RRO_BA_SESSION_STATUS
event and is now persisted per (station link, TID) in the driver rather
than only on the transient struct mt76_rx_tid, so teardown can reliably
look it up even after the software reorder context has been freed.

On RX BlockAck stop we therefore:

  * record the firmware session id into mt7996_sta_link when the status
    event is processed, keyed by TID, so it survives the lifetime of the
    software reorder buffer,
  * read and clear it in the IEEE80211_AMPDU_RX_STOP path and, when a
    session id was known, send UNI_RRO_DEL_BA_SESSION to release the
    firmware-side session,
  * keep processing the remaining events in the event skb instead of
    aborting on the first untracked session.

Combined with the session id being captured synchronously with the BA
add/stop flow (both run under dev->mt76.mutex), the stale NPU context
that previously poisoned wcid reuse on the second and later associations
is now torn down deterministically at disconnect.

Assisted-By: OpenCode
Signed-off-by: Tao Gong <gongtao0607@gmail.com>
---
 ...-release-HW_RRO-sessions-on-teardown.patch | 67 +++++++++++++++++++
 1 file changed, 67 insertions(+)
 create mode 100644 package/kernel/mt76/patches/0014-wifi-mt76-mt7996-release-HW_RRO-sessions-on-teardown.patch

diff --git a/package/kernel/mt76/patches/0014-wifi-mt76-mt7996-release-HW_RRO-sessions-on-teardown.patch b/package/kernel/mt76/patches/0014-wifi-mt76-mt7996-release-HW_RRO-sessions-on-teardown.patch
new file mode 100644
index 00000000000000..2a095e95d2d2566d2a4891db6fdbcc4fedd793b4
--- /dev/null
+++ b/package/kernel/mt76/patches/0014-wifi-mt76-mt7996-release-HW_RRO-sessions-on-teardown.patch
@@ -0,0 +1,67 @@
+--- a/mt7996/main.c
++++ b/mt7996/main.c
+@@ -1653,10 +1653,17 @@ mt7996_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+ 				   ssn, params->buf_size);
+ 		ret = mt7996_mcu_add_rx_ba(dev, params, vif, true);
+ 		break;
+-	case IEEE80211_AMPDU_RX_STOP:
++	case IEEE80211_AMPDU_RX_STOP: {
++		u16 session_id = msta->deflink.rro_id[tid];
++
++		msta->deflink.rro_id[tid] = 0;
+ 		mt76_rx_aggr_stop(&dev->mt76, &msta->deflink.wcid, tid);
+ 		ret = mt7996_mcu_add_rx_ba(dev, params, vif, false);
++
++		if (session_id && mt7996_has_hwrro(dev))
++			mt7996_mcu_wed_rro_reset_sessions(dev, session_id);
+ 		break;
++	}
+ 	case IEEE80211_AMPDU_TX_OPERATIONAL:
+ 		mtxq->aggr = true;
+ 		mtxq->send_bar = false;
+--- a/mt7996/mcu.c
++++ b/mt7996/mcu.c
+@@ -779,6 +779,7 @@ mt7996_mcu_wed_rro_event(struct mt7996_dev *dev, struct sk_buff *skb)
+ 		while (skb->len >= sizeof(*e)) {
+ 			struct mt76_rx_tid *tid;
+ 			struct mt76_wcid *wcid;
++			struct mt7996_sta_link *msta_link;
+ 			u16 idx;
+ 
+ 			e = (void *)skb->data;
+@@ -791,10 +792,18 @@ mt7996_mcu_wed_rro_event(struct mt7996_dev *dev, struct sk_buff *skb)
+ 				break;
+ 
+ 			tid = rcu_dereference(wcid->aggr[e->tid]);
+-			if (!tid)
+-				break;
++			if (!tid) {
++				/* BA session is not tracked on the primary
++				 * link (secondary link or already torn down);
++				 * keep processing the remaining events. */
++				skb_pull(skb, sizeof(*e));
++				continue;
++			}
+ 
+ 			tid->id = le16_to_cpu(e->id);
++			msta_link = container_of(wcid, struct mt7996_sta_link,
++						 wcid);
++			msta_link->rro_id[e->tid] = tid->id;
+ 			skb_pull(skb, sizeof(*e));
+ 		}
+ 		break;
+--- a/mt7996/mt7996.h
++++ b/mt7996/mt7996.h
+@@ -301,6 +301,12 @@ struct mt7996_sta_link {
+ 	unsigned long changed;
+ 
+ 	struct mt76_connac_sta_key_conf bip;
++	/* firmware-assigned HW_RRO session id per RX TID, reported by the
++	 * UNI_WED_RRO_BA_SESSION_STATUS event; consumed at BA teardown to
++	 * release the firmware-side session.  Written from the WED RRO event
++	 * handler, read/cleared under dev->mt76.mutex in the BA teardown
++	 * path. */
++	u16 rro_id[IEEE80211_NUM_TIDS];
+ 
+ 	struct {
+ 		u8 flowid_mask;
