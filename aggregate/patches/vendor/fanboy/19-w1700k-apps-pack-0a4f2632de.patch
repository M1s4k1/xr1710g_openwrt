+	// heartbeat pulse when new BND flows arrive
+	if (pulsing) p.push('<circle cx="150" cy="150" r="64" fill="none" stroke="#00c8ff" stroke-width="2" opacity="0.6" style="animation:sqm-pulse 1.2s ease-out forwards"/>');
