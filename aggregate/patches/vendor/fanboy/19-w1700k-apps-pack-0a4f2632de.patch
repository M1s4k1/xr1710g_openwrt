+
+# Stock firmware equivalent - uses reverse-engineered PWM values
+# RPM 770=PWM54, RPM1000=PWM69, RPM1400=PWM95, RPM2700=PWM199
+config curve 'quiet'
+	option point1_temp '45'
+	option point1_pwm '54'
+	option point2_temp '55'
+	option point2_pwm '69'
+	option point3_temp '65'
+	option point3_pwm '95'
+	option point4_temp '75'
+	option point4_pwm '199'
